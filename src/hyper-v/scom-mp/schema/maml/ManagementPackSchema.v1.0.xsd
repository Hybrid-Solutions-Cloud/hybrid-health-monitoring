  <xsi:complexType name="ManagementPackLanguagePack" xsdgen:include="true">
    <xsi:complexContent>
      <xsi:extension base="ManagementPackLanguageIdentity">
        <xsi:sequence>
          <xsi:element name="DisplayStrings" minOccurs="0">
            <xsi:complexType>
              <xsi:sequence>
                <xsi:element name="DisplayString" type="ManagementPackDisplayString" minOccurs="0" maxOccurs="unbounded" />
              </xsi:sequence>
            </xsi:complexType>
            <xsi:unique name="DisplayStringUnique">
              <xsi:selector xpath="./DisplayString" />
              <xsi:field xpath="@ElementID" />
              <xsi:field xpath="@SubElementID" />
            </xsi:unique>
          </xsi:element>
          <xsi:element name="KnowledgeArticles" minOccurs="0">
            <xsi:complexType>
              <xsi:sequence>
                <xsi:element name="KnowledgeArticle" type="ManagementPackKnowledgeArticle" minOccurs="0" maxOccurs="unbounded" />
              </xsi:sequence>
            </xsi:complexType>
          </xsi:element>
        </xsi:sequence>
        <xsi:attribute name="IsDefault" type="xsd:boolean" use="optional" default="false" />
      </xsi:extension>
    </xsi:complexContent>
