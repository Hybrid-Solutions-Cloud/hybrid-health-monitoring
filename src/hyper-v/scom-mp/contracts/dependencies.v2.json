    },
    {
      "id": "FailoverCluster",
      "status": "Approved",
      "optional": true,
      "packageVersion": "10.1.0.0",
      "download": "https://www.microsoft.com/en-us/download/details.aspx?id=54701",
      "managementPacks": [
        "Microsoft.Windows.Cluster.Management.Library",
        "Microsoft.Windows.2016.Cluster.Management.Library"
      ],
      "authoritativeClasses": [
        "Microsoft.Windows.Cluster",
        "Microsoft.Windows.Cluster.Node",
        "Microsoft.Windows.10.0.Cluster.Node",
        "Microsoft.Windows.Cluster.Group",
        "Microsoft.Windows.Cluster.Network",
        "Microsoft.Windows.Cluster.Resource"
      ]
    },
    {
      "id": "ClusterSharedVolume",
      "status": "Approved",
      "optional": true,
      "packageVersion": "10.1.2.2",
      "download": "https://www.microsoft.com/en-us/download/details.aspx?id=54303",
      "managementPacks": [
        "Microsoft.Windows.Server.Library",
        "Microsoft.Windows.Server.ClusterSharedVolumeMonitoring"
      ],
      "authoritativeClasses": [
        "Microsoft.Windows.Server.ClusterSharedVolumeMonitoring.ClusterSharedVolume",
        "Microsoft.Windows.Server.ClusterDisksMonitoring.ClusterDisk"
