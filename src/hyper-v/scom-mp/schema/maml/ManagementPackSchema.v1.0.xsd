    <xsi:complexContent>
      <xsi:extension base="ManagementPackElementInfo">
        <xsi:sequence>
          <xsi:element name="Name">
            <xsi:simpleType>
              <xsi:restriction base="xsd:string">
                <xsi:minLength value="0" />
                <xsi:maxLength value="4000" />
              </xsi:restriction>
            </xsi:simpleType>
          </xsi:element>
          <xsi:element name="Description" minOccurs="0">
            <xsi:simpleType>
              <xsi:restriction base="xsd:string">
                <xsi:minLength value="0" />
                <xsi:maxLength value="4000" />
              </xsi:restriction>
            </xsi:simpleType>
          </xsi:element>
        </xsi:sequence>
      </xsi:extension>
    </xsi:complexContent>
  </xsi:complexType>
  <xsi:complexType name="ManagementPackKnowledgeArticle" xsdgen:include="true">
    <xsi:complexContent>
      <xsi:extension base="ManagementPackElementInfo">
        <xsi:sequence>
          <xsi:choice>
            <xsi:element name="MamlContent">
              <xsi:complexType>
                <xsi:complexContent>
                  <xsi:restriction base="maml:sectionsType">
                    <xsi:sequence maxOccurs="unbounded">
                      <xsi:element ref="maml:section" />
                    </xsi:sequence>
                  </xsi:restriction>
                </xsi:complexContent>
              </xsi:complexType>
            </xsi:element>
            <xsi:element name="HtmlContent" type="xsi:string" />
          </xsi:choice>
        </xsi:sequence>
        <xsi:attribute name="Visible" type="xsd:boolean" use="optional" default="true" />
      </xsi:extension>
