  <Manifest>
    <Identity><ID>HyperVPrivateCloud.Overrides.VMMManaged.Strict.Discovery</ID><Version>{{VERSION}}</Version></Identity>
    <Name>Hyper-V Private Cloud Monitoring - VMMManaged Strict Discovery Overrides</Name>
    <References>
      <Reference Alias="Windows"><ID>Microsoft.Windows.Library</ID><Version>7.5.8501.0</Version><PublicKeyToken>31bf3856ad364e35</PublicKeyToken></Reference>
      <Reference Alias="VMMDiscovery"><ID>Microsoft.SystemCenter.VirtualMachineManager.Discovery</ID><Version>11.19.0.3</Version><PublicKeyToken>31bf3856ad364e35</PublicKeyToken></Reference>
