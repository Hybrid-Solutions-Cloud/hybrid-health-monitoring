#Requires -Version 5.1
param([string]$ComputerName, [string]$BoundaryId, [int]$FailoverWindowHours = 24)

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'
$WarningPreference = 'SilentlyContinue'

function Test-HcsCapability {
    param([string]$ModuleName, [string]$CommandName)
    if (Get-Command -Name $CommandName -ErrorAction SilentlyContinue) { return $true }
    # This workflow runs on the Windows PowerShell 5.1 host, where FailoverClusters is a native
    # module, so a plain import is sufficient. Do NOT reintroduce -SkipEditionCheck or
    # -UseWindowsPowerShell: both are PowerShell 7 parameters and raise ParameterBindingException
    # under 5.1. They existed only to work around running this module under pwsh.exe.
    try { Import-Module -Name $ModuleName -WarningAction SilentlyContinue -ErrorAction SilentlyContinue } catch { }
    return $null -ne (Get-Command -Name $CommandName -ErrorAction SilentlyContinue)
}

function Get-HcsProperty {
    param($InputObject, [string]$Name, $Default = $null)
    if ($null -eq $InputObject) { return $Default }
    $property = $InputObject.PSObject.Properties[$Name]
    if ($null -eq $property) { return $Default }
    if ($null -eq $property.Value) { return $Default }
    return $property.Value
}

function Get-HcsStatusText {
    param($InputObject, [string]$Name)
    $value = Get-HcsProperty -InputObject $InputObject -Name $Name -Default ''
    return (@($value) | ForEach-Object { [string]$_ }) -join ','
}

function Get-HcsNumber {
    param($Value, [double]$Default = 0)
    if ($null -eq $Value) { return $Default }
    $parsed = 0.0
    if ([double]::TryParse([string]$Value, [ref]$parsed)) { return $parsed }
    return $Default
}

# Query failures must be visible. Returning an empty collection made a failed node, network, group,
# CSV, event or performance query indistinguishable from "nothing found", and because the probe starts
# at Good that reported a broken cluster as healthy. Failures are recorded and surfaced by the caller.
$script:HcsCollectionFailures = [System.Collections.Generic.List[string]]::new()
function Get-HcsSafeCollection {
    param([scriptblock]$Query, [string]$Name = 'cluster query', [switch]$AllowNoMatchingEvents)
    try { return , @(& $Query) }
    catch {
        # Get-WinEvent reports an empty, successful search as a non-terminating error.
        # Only this exact condition is benign; missing logs and access failures remain faults.
        if ($AllowNoMatchingEvents -and $_.FullyQualifiedErrorId -like 'NoMatchingEventsFound*') {
            return , @()
        }
        $script:HcsCollectionFailures.Add("$Name failed: $($_.Exception.Message)")
        return , @()
    }
}

$api = New-Object -ComObject 'MOM.ScriptAPI'
$bag = $api.CreatePropertyBag()

if ($FailoverWindowHours -le 0) { $FailoverWindowHours = 24 }

# Benign defaults. A standalone host, or a host without the FailoverClusters module,
# reports zero fault counts and full free capacity so that no threshold monitor fires.
$state = 'Good'
$detail = "Failover Cluster and CSV depth metrics collected on '$ComputerName'."
$csvCount = 0
$csvOfflineCount = 0
$csvPausedCount = 0
$csvRedirectedCount = 0
$csvBackupInProgressCount = 0
$csvWorstFreePercent = 100.0
$csvUsedPercent = 0.0
$csvMaxReadLatencyMs = 0.0
$csvMaxWriteLatencyMs = 0.0
$csvMaxQueueDepth = 0.0
$csvDetail = 'No Cluster Shared Volume is present.'
$csvExamples = [System.Collections.Generic.List[string]]::new()
$csvWorstFreeVolume = ''
$csvWorstReadPath = ''
$csvWorstWritePath = ''
$csvWorstQueuePath = ''
$nodeCount = 0
$nodeDownCount = 0
$nodePausedCount = 0
$nodeDetail = 'No cluster node information is available.'
$quorumType = 'NotApplicable'
$quorumWitnessType = 'NotApplicable'
$quorumWitnessState = 'NotApplicable'
$quorumWitnessFailedCount = 0
$quorumAssignedVotes = 0.0
$quorumCurrentVotes = 0.0
$quorumVoteMarginCount = 99.0
$quorumDetail = 'No cluster quorum information is available.'
$networkCount = 0
$networkDownCount = 0
$networkPartitionedCount = 0
$networkUnavailableCount = 0
$networkDetail = 'No cluster network information is available.'
$groupCount = 0
$groupOfflineCount = 0
$groupFailedCount = 0
$groupFailoverEventCount = 0
$groupDetail = 'No cluster role information is available.'

try {
    if (-not (Test-HcsCapability -ModuleName 'FailoverClusters' -CommandName 'Get-Cluster')) {
        $state = 'NotApplicable'
        $detail = "The FailoverClusters PowerShell module is unavailable on '$ComputerName'; Failover Cluster and CSV metrics were not collected. Install-WindowsFeature RSAT-Clustering-PowerShell, verify Get-Cluster is available to Local System, then restart the HealthService. Supplied BoundaryId='$BoundaryId'."
    }
    else {
        $cluster = $null
        try { $cluster = Get-Cluster -ErrorAction Stop }
        catch {
            $clusterService = Get-Service -Name 'ClusSvc' -ErrorAction SilentlyContinue
            if ($BoundaryId -like 'cluster:*' -or $null -ne $clusterService) { throw }
        }

        if ($null -eq $cluster) {
            $state = 'NotApplicable'
            $detail = 'This Hyper-V host is not a Failover Cluster node; Failover Cluster and CSV depth monitoring is not applicable.'
        }
        else {
            # HostRole is initially created by the registry seed and its optional BoundaryId is populated
            # later by topology discovery. Detect real cluster membership locally so that an empty staged
            # property cannot silently disable CSV monitoring during convergence or after a stale update.
            if ([string]::IsNullOrWhiteSpace($BoundaryId) -or $BoundaryId -notlike 'cluster:*') {
                $BoundaryId = "cluster:$(([string]$cluster.Name).ToLowerInvariant())"
            }

            # ---- Cluster nodes ---------------------------------------------------
            # This probe runs on a cluster node. Keep queries local: specifying the cluster
            # network name can turn LocalSystem collection into an authenticated remote call
            # to the owner node, which fails on passive nodes without remote cluster rights.
            $nodes = Get-HcsSafeCollection -Name 'local cluster nodes' -Query { Get-ClusterNode -ErrorAction Stop }
            $nodeCount = $nodes.Count
            foreach ($node in $nodes) {
                $nodeState = Get-HcsStatusText -InputObject $node -Name 'State'
                if ($nodeState -match 'Down|Joining|Unknown') { $nodeDownCount++ }
                if ($nodeState -match 'Paused') { $nodePausedCount++ }
            }
            if ($nodeCount -gt 0) {
                $nodeExamples = @($nodes | Select-Object -First 16 | ForEach-Object { "'$(Get-HcsProperty $_ 'Name' 'unknown')'=$(Get-HcsStatusText $_ 'State')" }) -join '; '
                $nodeDetail = "Cluster '$($cluster.Name)' has $nodeCount node(s): $nodeDownCount not up, $nodePausedCount paused. Node states (first 16): $nodeExamples."
            }

        # ---- Quorum and witness ----------------------------------------------
        $quorum = $null
        $quorumResults = Get-HcsSafeCollection -Name 'local cluster quorum' -Query { Get-ClusterQuorum -ErrorAction Stop }
        if ($quorumResults.Count -gt 0) { $quorum = $quorumResults[0] }
        if ($null -ne $quorum) {
            $quorumType = Get-HcsStatusText -InputObject $quorum -Name 'QuorumType'
            $witness = Get-HcsProperty -InputObject $quorum -Name 'QuorumResource' -Default $null
            if ($null -ne $witness) {
                $quorumWitnessType = Get-HcsStatusText -InputObject $witness -Name 'ResourceType'
                $quorumWitnessState = Get-HcsStatusText -InputObject $witness -Name 'State'
                if ($quorumWitnessState -notmatch 'Online') { $quorumWitnessFailedCount = 1 }
            }
            else {
                $quorumWitnessType = 'None'
                $quorumWitnessState = 'NotConfigured'
            }
        }

        # Dynamic quorum: the vote the cluster is actually using is DynamicWeight (node) and
        # WitnessDynamicWeight (witness); NodeWeight / configured witness are the fallback on builds
        # that do not expose them. Margin = votes that can still be lost before quorum is lost, so a
        # healthy cluster at exact majority reports 0.
        $witnessVote = if ($quorumWitnessType -in @('NotApplicable', 'None')) { 0.0 } else { 1.0 }
        $witnessDynamic = Get-HcsProperty -InputObject $cluster -Name 'WitnessDynamicWeight' -Default $null
        if ($null -ne $witnessDynamic -and $witnessVote -gt 0) { $witnessVote = Get-HcsNumber $witnessDynamic 1 }
        foreach ($node in $nodes) {
            $dynamicWeight = Get-HcsProperty -InputObject $node -Name 'DynamicWeight' -Default $null
            $weight = if ($null -ne $dynamicWeight) { Get-HcsNumber $dynamicWeight 1 } else { Get-HcsNumber (Get-HcsProperty -InputObject $node -Name 'NodeWeight' -Default 1) 1 }
            $quorumAssignedVotes += $weight
            # Paused blocks role placement, not cluster membership. Honor its actual dynamic vote.
            if ((Get-HcsStatusText -InputObject $node -Name 'State') -in @('Up', 'Paused')) { $quorumCurrentVotes += $weight }
        }
        $quorumAssignedVotes += $witnessVote
        if ($quorumWitnessFailedCount -eq 0) { $quorumCurrentVotes += $witnessVote }

        if ($quorumAssignedVotes -gt 0) {
            # Votes that may still be lost before the cluster loses quorum (0 = at exact majority).
            $majority = [math]::Floor($quorumAssignedVotes / 2) + 1
            $quorumVoteMarginCount = $quorumCurrentVotes - $majority
            $quorumDetail = "Quorum model '$quorumType' with witness '$quorumWitnessType' in state '$quorumWitnessState'. $quorumCurrentVotes of $quorumAssignedVotes vote(s) present; current vote margin=$quorumVoteMarginCount. This is a point-in-time vote calculation, not a guarantee of surviving that many node or storage failures; dynamic quorum, witness and pool resiliency can change the outcome."
        }

        # ---- Cluster networks -------------------------------------------------
        $networks = Get-HcsSafeCollection -Name 'local cluster networks' -Query { Get-ClusterNetwork -ErrorAction Stop }
        $networkCount = $networks.Count
        foreach ($network in $networks) {
            $networkState = Get-HcsStatusText -InputObject $network -Name 'State'
            if ($networkState -match 'Down') { $networkDownCount++ }
            if ($networkState -match 'Partitioned') { $networkPartitionedCount++ }
            if ($networkState -match 'Unavailable|Unknown') { $networkUnavailableCount++ }
        }
        if ($networkCount -gt 0) {
            $networkExamples = @($networks | Select-Object -First 16 | ForEach-Object { "'$(Get-HcsProperty $_ 'Name' 'unknown')'=$(Get-HcsStatusText $_ 'State')" }) -join '; '
            $networkDetail = "$networkCount cluster network(s): $networkDownCount down, $networkPartitionedCount partitioned, $networkUnavailableCount unavailable. Network states (first 16): $networkExamples."
        }

        # ---- Cluster groups and failover churn ---------------------------------
        $groups = Get-HcsSafeCollection -Name 'local cluster groups' -Query { Get-ClusterGroup -ErrorAction Stop }
        $groupCount = $groups.Count
        foreach ($group in $groups) {
            $groupState = Get-HcsStatusText -InputObject $group -Name 'State'
            if ($groupState -match 'Offline') { $groupOfflineCount++ }
            if ($groupState -match 'Failed|PartialOnline') { $groupFailedCount++ }
        }
        $windowStart = (Get-Date).AddHours(-1 * $FailoverWindowHours)
        $failoverEvents = Get-HcsSafeCollection -Name 'cluster failover events' -AllowNoMatchingEvents -Query {
            Get-WinEvent -FilterHashtable @{
                LogName      = 'System'
                ProviderName = 'Microsoft-Windows-FailoverClustering'
                # 1177 (quorum lost) is an outage Microsoft's cluster MP alerts on directly, not failover churn.
                Id           = @(1069, 1205, 1254)
                StartTime    = $windowStart
            } -ErrorAction Stop
        }
        # These are failure episodes, not proven ownership changes. Event 1069's FIRST property is
        # ResourceName, whereas 1205/1254 carry ResourceGroup. Read named XML fields to correlate
        # multiple failing resources with their role, then bucket each role in five-minute windows.
        $transitionKeys = [System.Collections.Generic.HashSet[string]]::new([StringComparer]::OrdinalIgnoreCase)
        $failureExamples = [System.Collections.Generic.List[string]]::new()
        foreach ($failoverEvent in @($failoverEvents | Sort-Object TimeCreated -Descending)) {
            $roleName = 'unknown'
            $eventFields = @{}
            try {
                [xml]$eventXml = $failoverEvent.ToXml()
                foreach ($field in $eventXml.SelectNodes('//*[local-name()="EventData"]/*[local-name()="Data"]')) {
                    $eventFields[$field.GetAttribute('Name')] = $field.InnerText
                }
                if ($eventFields['ResourceGroup']) { $roleName = $eventFields['ResourceGroup'] }
            }
            catch { }
            if ($roleName -eq 'unknown') {
                # Preserve evidence without claiming to identify a role from a resource-name field.
                $roleName = 'unresolved-event-' + [string](Get-HcsProperty $failoverEvent 'RecordId' $failoverEvent.TimeCreated.Ticks)
            }
            $bucket = [int][math]::Floor($failoverEvent.TimeCreated.ToUniversalTime().Ticks / [timespan]::FromMinutes(5).Ticks)
            [void]$transitionKeys.Add("$roleName|$bucket")
            if ($failureExamples.Count -lt 8) {
                $failureExamples.Add("UTC=$($failoverEvent.TimeCreated.ToUniversalTime().ToString('o')); Event=$($failoverEvent.Id); Role='$roleName'; Resource='$($eventFields['ResourceName'])'; Error='$($eventFields['ApplicationErrorCode'])' ($($eventFields['ErrorCause']))")
            }
        }
        $groupFailoverEventCount = $transitionKeys.Count
        if ($groupCount -gt 0) {
            $unhealthyGroups = @($groups | Where-Object { (Get-HcsStatusText $_ 'State') -match 'Offline|Failed|PartialOnline' })
            $roleExamples = @($unhealthyGroups | Select-Object -First 12 | ForEach-Object { "'$(Get-HcsProperty $_ 'Name' 'unknown')'=$(Get-HcsStatusText $_ 'State') (owner=$(Get-HcsProperty $_ 'OwnerNode' 'unknown'))" }) -join '; '
            $groupDetail = "Cluster='$($cluster.Name)'; Collector='$ComputerName'; SampleUTC=$([datetime]::UtcNow.ToString('o')). $groupCount cluster role(s): $groupOfflineCount offline, $groupFailedCount failed or partially online. $groupFailoverEventCount role failure episode(s), grouped by role and five-minute window, from $($failoverEvents.Count) local System events (1069/1205/1254) in the last $FailoverWindowHours hour(s); this is NOT a count of VM migrations or confirmed failovers. Non-online roles (first 12 of $($unhealthyGroups.Count)): $roleExamples. Latest failure evidence (up to 8): $($failureExamples -join ' | '). Offline does not by itself prove an outage: check intended VM state and empty Available Storage groups. Counts can remain elevated until the event window expires after repair."
        }

        # ---- Cluster Shared Volumes -------------------------------------------
        if (Get-Command -Name 'Get-ClusterSharedVolume' -ErrorAction SilentlyContinue) {
            $csvs = Get-HcsSafeCollection -Name 'local cluster shared volumes' -Query { Get-ClusterSharedVolume -ErrorAction Stop }
            $csvCount = $csvs.Count
            if ($csvCount -gt 0) {
                $csvWorstFreePercent = 100.0
                foreach ($csv in $csvs) {
                    $csvState = Get-HcsStatusText -InputObject $csv -Name 'State'
                    if ($csvState -match 'Offline|Failed') { $csvOfflineCount++ }
                    if ($csvState -match 'Paused') { $csvPausedCount++ }

                    $volumeInfos = @(Get-HcsProperty -InputObject $csv -Name 'SharedVolumeInfo' -Default @())
                    foreach ($volumeInfo in $volumeInfos) {
                        if ([bool](Get-HcsProperty -InputObject $volumeInfo -Name 'RedirectedAccess' -Default $false)) { $csvRedirectedCount++ }
                        if ([bool](Get-HcsProperty -InputObject $volumeInfo -Name 'BackupInProgress' -Default $false)) { $csvBackupInProgressCount++ }

                        $partition = Get-HcsProperty -InputObject $volumeInfo -Name 'Partition' -Default $null
                        if ($null -ne $partition) {
                            $size = Get-HcsNumber (Get-HcsProperty -InputObject $partition -Name 'Size' -Default 0)
                            $free = Get-HcsNumber (Get-HcsProperty -InputObject $partition -Name 'FreeSpace' -Default 0)
                            if ($size -gt 0) {
                                $freePercent = [math]::Round(($free / $size) * 100, 2)
                                if ($freePercent -lt $csvWorstFreePercent) { $csvWorstFreePercent = $freePercent; $csvWorstFreeVolume = [string](Get-HcsProperty $csv 'Name' 'unknown') }
                            }
                        }
                        if ($csvExamples.Count -lt 12) {
                            $csvExamples.Add("'$(Get-HcsProperty $csv 'Name' 'unknown')': State=$csvState; Owner=$(Get-HcsProperty $csv 'OwnerNode' 'unknown'); Path=$(Get-HcsProperty $volumeInfo 'FriendlyVolumeName' 'unknown'); Redirected=$(Get-HcsProperty $volumeInfo 'RedirectedAccess' 'unknown'); Backup=$(Get-HcsProperty $volumeInfo 'BackupInProgress' 'unknown')")
                        }
                    }
                }
                $csvUsedPercent = [math]::Round(100.0 - $csvWorstFreePercent, 2)
                $csvDetail = "$csvCount Cluster Shared Volume(s): worst free space $csvWorstFreePercent% on '$csvWorstFreeVolume', $csvRedirectedCount in redirected access, $csvOfflineCount offline or failed, $csvPausedCount paused, $csvBackupInProgressCount in backup. Volume detail (up to 12): $($csvExamples -join ' | ')."
            }
        }

        # ---- CSV I/O latency and queue depth -----------------------------------
        # Cluster CSV latency counters are published in seconds and are normalised to
        # milliseconds here so that thresholds read naturally to an operator.
        if ($csvCount -gt 0) {
        $counterSet = Get-HcsSafeCollection { Get-Counter -ListSet 'Cluster CSV File System' -ErrorAction Stop }
        if ($counterSet.Count -eq 0) {
            $counterSet = Get-HcsSafeCollection { Get-Counter -ListSet 'Cluster CSV Volume Manager' -ErrorAction Stop }
        }
        if ($counterSet.Count -gt 0) {
            $paths = @(Get-HcsProperty -InputObject $counterSet[0] -Name 'Paths' -Default @())
            $wanted = @($paths | Where-Object { $_ -match 'Read Latency|Write Latency|Queue Length' })
            if ($wanted.Count -gt 0) {
                $samples = Get-HcsSafeCollection { (Get-Counter -Counter $wanted -ErrorAction Stop).CounterSamples }
                foreach ($sample in $samples) {
                    $path = Get-HcsStatusText -InputObject $sample -Name 'Path'
                    $value = Get-HcsNumber (Get-HcsProperty -InputObject $sample -Name 'CookedValue' -Default 0)
                    if ($path -match 'Read Latency') {
                        $milliseconds = [math]::Round($value * 1000, 3)
                        if ($milliseconds -gt $csvMaxReadLatencyMs) { $csvMaxReadLatencyMs = $milliseconds; $csvWorstReadPath = $path }
                    }
                    elseif ($path -match 'Write Latency') {
                        $milliseconds = [math]::Round($value * 1000, 3)
                        if ($milliseconds -gt $csvMaxWriteLatencyMs) { $csvMaxWriteLatencyMs = $milliseconds; $csvWorstWritePath = $path }
                    }
                    elseif ($path -match 'Queue Length') {
                        if ($value -gt $csvMaxQueueDepth) { $csvMaxQueueDepth = [math]::Round($value, 3); $csvWorstQueuePath = $path }
                    }
                }
            }
        }

        }
            $csvDetail += " Measured maxima: ReadLatencyMs=$csvMaxReadLatencyMs (counter='$csvWorstReadPath'); WriteLatencyMs=$csvMaxWriteLatencyMs (counter='$csvWorstWritePath'); QueueDepth=$csvMaxQueueDepth (counter='$csvWorstQueuePath')."
            $detail = "Failover Cluster and CSV depth metrics collected on '$ComputerName' for '$BoundaryId'. $csvDetail $nodeDetail $quorumDetail $networkDetail $groupDetail"
        }
    }
}
catch {
    $state = 'Critical'
    $failureType = $_.Exception.GetType().FullName
    $detail = "Failover Cluster and CSV collection failed. Computer='$ComputerName'; SuppliedBoundaryId='$BoundaryId'; ErrorType='$failureType'; Error='$($_.Exception.Message)'. Run Get-Cluster, Get-ClusterNode, Get-ClusterSharedVolume, and Get-Counter -ListSet 'Cluster CSV File System' as Local System; repair the first failing query, then restart the HealthService."
    $api.LogScriptEvent('HyperVPrivateCloud.Cluster.CsvHealth.ps1', 8304, 1, $detail)
}

# A query that failed is not a query that found nothing. If any collection failed, the probe must not
# report Good: every downstream count (nodes, networks, groups, CSVs, failover events) would be zero
# and read as healthy. Surface it as Warning with the failing query named.
if ($script:HcsCollectionFailures.Count -gt 0) {
    if ($state -eq 'Good') { $state = 'Warning' }
    $detail = "$detail Cluster data collection was incomplete: $($script:HcsCollectionFailures -join '; '). Counts below are partial and must not be read as healthy."
    $api.LogScriptEvent('HyperVPrivateCloud.Cluster.CsvHealth.ps1', 8304, 2, $detail)
}

$bag.AddValue('ClusterCsvHealthState', $state)
$bag.AddValue('ClusterCsvHealthDetail', $detail)

$bag.AddValue('CsvCount', [double]$csvCount)
$bag.AddValue('CsvOfflineCount', [double]$csvOfflineCount)
$bag.AddValue('CsvPausedCount', [double]$csvPausedCount)
$bag.AddValue('CsvRedirectedCount', [double]$csvRedirectedCount)
$bag.AddValue('CsvBackupInProgressCount', [double]$csvBackupInProgressCount)
$bag.AddValue('CsvWorstFreePercent', [double]$csvWorstFreePercent)
$bag.AddValue('CsvUsedPercent', [double]$csvUsedPercent)
$bag.AddValue('CsvMaxReadLatencyMs', [double]$csvMaxReadLatencyMs)
$bag.AddValue('CsvMaxWriteLatencyMs', [double]$csvMaxWriteLatencyMs)
$bag.AddValue('CsvMaxQueueDepth', [double]$csvMaxQueueDepth)
$bag.AddValue('CsvDetail', $csvDetail)

$bag.AddValue('NodeCount', [double]$nodeCount)
$bag.AddValue('NodeDownCount', [double]$nodeDownCount)
$bag.AddValue('NodePausedCount', [double]$nodePausedCount)
$bag.AddValue('NodeDetail', $nodeDetail)

$bag.AddValue('QuorumType', $quorumType)
$bag.AddValue('QuorumWitnessType', $quorumWitnessType)
$bag.AddValue('QuorumWitnessState', $quorumWitnessState)
$bag.AddValue('QuorumWitnessFailedCount', [double]$quorumWitnessFailedCount)
$bag.AddValue('QuorumAssignedVotes', [double]$quorumAssignedVotes)
$bag.AddValue('QuorumCurrentVotes', [double]$quorumCurrentVotes)
$bag.AddValue('QuorumVoteMarginCount', [double]$quorumVoteMarginCount)
$bag.AddValue('QuorumDetail', $quorumDetail)

$bag.AddValue('NetworkCount', [double]$networkCount)
$bag.AddValue('NetworkDownCount', [double]$networkDownCount)
$bag.AddValue('NetworkPartitionedCount', [double]$networkPartitionedCount)
$bag.AddValue('NetworkUnavailableCount', [double]$networkUnavailableCount)
$bag.AddValue('NetworkDetail', $networkDetail)

$bag.AddValue('GroupCount', [double]$groupCount)
$bag.AddValue('GroupOfflineCount', [double]$groupOfflineCount)
$bag.AddValue('GroupFailedCount', [double]$groupFailedCount)
$bag.AddValue('GroupFailoverEventCount', [double]$groupFailoverEventCount)
$bag.AddValue('GroupFailoverWindowHours', [double]$FailoverWindowHours)
$bag.AddValue('GroupDetail', $groupDetail)

$api.Return($bag)
