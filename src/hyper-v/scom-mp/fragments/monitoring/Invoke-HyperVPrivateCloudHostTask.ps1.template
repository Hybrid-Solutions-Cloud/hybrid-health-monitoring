#Requires -Version 7.0
# Operator tasks for the Hyper-V host and its virtual machines. Read-only actions come first in the
# ValidateSet (the probe smoke test runs the first one); remediation actions change state and are
# exposed as separate Task elements that the console asks the operator to confirm.
param(
    [ValidateSet('VmInventory', 'HostHeadroom', 'EventTail', 'LiveMigrationSettings', 'SwitchConfiguration', 'PendingReboot', 'PipelineSelfTest', 'HyperVBpa',
        'VmDetail', 'VmPerformance', 'VmReplica',
        'TestDomainHealth', 'TestDnsResolution', 'TestPortConnectivity', 'TestPxeWdsHealth',
        'TestChassisBmcConnectivity', 'TestNetworkSwitchConnectivity', 'TestFirewallGateway', 'TestOpengearPort', 'TestDhcpScopeHealth',
        'RestartVmms', 'RestartVmCompute', 'StartVm', 'StopVm', 'SaveVm', 'ResumeVm', 'RestartVm', 'MergeCheckpoints', 'CreateCheckpoint', 'ResumeReplication', 'MoveVmToBestNode')]
    [string]$Action = 'VmInventory',
    [string]$Parameter = '',
    [string]$ComputerName = $env:COMPUTERNAME
)

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'
$WarningPreference = 'SilentlyContinue'

$lines = [System.Collections.Generic.List[string]]::new()
function Add-HcsText { param($Object) if ($null -ne $Object) { $lines.Add((($Object | Out-String -Width 220).TrimEnd())) } }
function Add-HcsSection { param([string]$Title) $lines.Add(''); $lines.Add("=== $Title ===") }
function Import-HcsModule { param([string]$Name)
    if (-not (Get-Module -ListAvailable -Name $Name -ErrorAction SilentlyContinue)) { return $false }
    Import-Module -Name $Name -ErrorAction SilentlyContinue -WarningAction SilentlyContinue
    return $true
}
function Get-HcsVm {
    if ([string]::IsNullOrWhiteSpace($Parameter)) { throw 'Parameter must carry the VM Id or name.' }
    $vm = $null
    try { $vm = Get-VM -Id $Parameter -ErrorAction Stop } catch { $vm = $null }
    if ($null -eq $vm) { $vm = Get-VM -Name $Parameter -ErrorAction Stop | Select-Object -First 1 }
    return $vm
}

$lines.Add("Hyper-V Private Cloud task '$Action' on $ComputerName at $([DateTime]::UtcNow.ToString('o'))")
try {
    if ($Action -notin @('TestDomainHealth', 'TestDnsResolution', 'TestPortConnectivity', 'TestPxeWdsHealth', 'TestChassisBmcConnectivity', 'TestNetworkSwitchConnectivity', 'TestFirewallGateway', 'TestOpengearPort', 'TestDhcpScopeHealth')) {
        if (-not (Import-HcsModule -Name 'Hyper-V')) { throw 'The Hyper-V PowerShell module is not available on this host.' }
    }
    switch ($Action) {
        'VmInventory' {
            Add-HcsSection 'Virtual machines'
            Add-HcsText (Get-VM | Sort-Object Name | Select-Object Name, State, Status, Uptime, ProcessorCount, @{ n = 'MemoryAssignedMB'; e = { [int]($_.MemoryAssigned / 1MB) } }, DynamicMemoryEnabled, Version, Generation, IsClustered, AutomaticStartAction | Format-Table -AutoSize)
        }
        'HostHeadroom' {
            $hostInfo = Get-VMHost
            $os = Get-CimInstance Win32_OperatingSystem
            $vms = @(Get-VM)
            Add-HcsSection 'Host'
            Add-HcsText ([pscustomobject]@{
                    LogicalProcessors = $hostInfo.LogicalProcessorCount
                    VirtualProcessorsAssignedToRunningVMs = (($vms | Where-Object State -eq 'Running' | Measure-Object -Property ProcessorCount -Sum).Sum)
                    MemoryTotalMB = [int]($hostInfo.MemoryCapacity / 1MB)
                    MemoryFreeMB = [int]($os.FreePhysicalMemory / 1KB)
                    MemoryAssignedToVMsMB = [int](($vms | Measure-Object -Property MemoryAssigned -Sum).Sum / 1MB)
                    MemoryDemandOfVMsMB = [int](($vms | Measure-Object -Property MemoryDemand -Sum).Sum / 1MB)
                    NumaSpanningEnabled = $hostInfo.NumaSpanningEnabled
                    RunningVMs = @($vms | Where-Object State -eq 'Running').Count
                    TotalVMs = $vms.Count
                } | Format-List)
            Add-HcsSection 'NUMA'
            Add-HcsText ($hostInfo.NumaStatus | Format-Table -AutoSize)
        }
        'EventTail' {
            $max = if ($Parameter -match '^\d+$') { [int]$Parameter } else { 25 }
            foreach ($log in @('Microsoft-Windows-Hyper-V-VMMS-Admin', 'Microsoft-Windows-Hyper-V-Worker-Admin', 'Microsoft-Windows-Hyper-V-Hypervisor-Admin', 'Microsoft-Windows-Hyper-V-StorageVSP-Admin', 'Microsoft-Windows-Hyper-V-Config-Admin')) {
                Add-HcsSection "$log (last $max errors/warnings)"
                try { Add-HcsText (Get-WinEvent -FilterHashtable @{ LogName = $log; Level = @(1, 2, 3) } -MaxEvents $max -ErrorAction Stop | Select-Object TimeCreated, Id, LevelDisplayName, @{ n = 'Message'; e = { ($_.Message -split "`n")[0] } } | Format-Table -AutoSize -Wrap) }
                catch { $lines.Add("  (no events or log unavailable: $($_.Exception.Message))") }
            }
        }
        'LiveMigrationSettings' {
            Add-HcsSection 'Live migration'
            Add-HcsText (Get-VMHost | Select-Object VirtualMachineMigrationEnabled, VirtualMachineMigrationAuthenticationType, VirtualMachineMigrationPerformanceOption, MaximumVirtualMachineMigrations, MaximumStorageMigrations, UseAnyNetworkForMigration | Format-List)
            Add-HcsText (Get-VMMigrationNetwork -ErrorAction SilentlyContinue | Format-Table -AutoSize)
            Add-HcsSection 'Recent migration events (VMMS 20xxx/21xxx)'
            try { Add-HcsText (Get-WinEvent -FilterHashtable @{ LogName = 'Microsoft-Windows-Hyper-V-VMMS-Admin'; Id = @(20413, 20417, 21501, 21502, 21125, 21024) } -MaxEvents 20 -ErrorAction Stop | Select-Object TimeCreated, Id, @{ n = 'Message'; e = { ($_.Message -split "`n")[0] } } | Format-Table -AutoSize -Wrap) } catch { $lines.Add('  (none)') }
        }
        'SwitchConfiguration' {
            Add-HcsSection 'Virtual switches'
            Add-HcsText (Get-VMSwitch | Select-Object Name, SwitchType, EmbeddedTeamingEnabled, IovEnabled, BandwidthReservationMode, NetAdapterInterfaceDescriptions | Format-List)
            Add-HcsSection 'SET team members'
            Add-HcsText (Get-VMSwitchTeam -ErrorAction SilentlyContinue | Format-List)
            Add-HcsSection 'Physical adapters'
            Add-HcsText (Get-NetAdapter -Physical -ErrorAction SilentlyContinue | Select-Object Name, InterfaceDescription, Status, LinkSpeed, MacAddress, DriverVersion | Format-Table -AutoSize)
            Add-HcsText (Get-NetAdapterRdma -ErrorAction SilentlyContinue | Select-Object Name, Enabled, OperationalState | Format-Table -AutoSize)
        }
        'PendingReboot' {
            $pending = [ordered]@{
                ComponentBasedServicing = Test-Path 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Component Based Servicing\RebootPending'
                WindowsUpdate = Test-Path 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\WindowsUpdate\Auto Update\RebootRequired'
                PendingFileRename = [bool](Get-ItemProperty 'HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager' -Name PendingFileRenameOperations -ErrorAction SilentlyContinue)
                LastBootUtc = (Get-CimInstance Win32_OperatingSystem).LastBootUpTime.ToUniversalTime().ToString('o')
            }
            Add-HcsSection 'Pending reboot'
            Add-HcsText ([pscustomobject]$pending | Format-List)
        }
        'PipelineSelfTest' {
            Add-HcsSection 'Monitoring pipeline'
            Add-HcsText ([pscustomobject]@{
                    PowerShell = $PSVersionTable.PSVersion.ToString()
                    Process = (Get-Process -Id $PID).Path
                    HyperVModule = (Get-Module Hyper-V -ListAvailable | Select-Object -First 1).Version.ToString()
                    FailoverClustersModule = [bool](Get-Module FailoverClusters -ListAvailable)
                    StorageModule = [bool](Get-Module Storage -ListAvailable)
                    HypervisorPresent = (Get-CimInstance Win32_ComputerSystem).HypervisorPresent
                    VmmsService = (Get-Service vmms -ErrorAction SilentlyContinue).Status
                    VmComputeService = (Get-Service vmcompute -ErrorAction SilentlyContinue).Status
                    GetVmWorks = $(try { $null = Get-VM; $true } catch { $_.Exception.Message })
                    HealthServiceRunning = (Get-Service HealthService -ErrorAction SilentlyContinue).Status
                } | Format-List)
        }
        'HyperVBpa' {
            Add-HcsSection 'Hyper-V Best Practices Analyzer'
            if (Get-Command Invoke-BpaModel -ErrorAction SilentlyContinue) {
                $null = Invoke-BpaModel -ModelId 'Microsoft/Windows/Hyper-V' -ErrorAction Stop
                Add-HcsText (Get-BpaResult -ModelId 'Microsoft/Windows/Hyper-V' -ErrorAction Stop | Where-Object { $_.Severity -ne 'Information' -and -not $_.Compliance.StartsWith('Compliant') } | Select-Object Severity, Category, Title | Format-Table -AutoSize -Wrap)
            }
            else { $lines.Add('The BestPractices module is not available on this host.') }
        }
        'VmDetail' {
            $vm = Get-HcsVm
            Add-HcsSection "VM $($vm.Name)"
            Add-HcsText ($vm | Select-Object Name, Id, State, Status, Uptime, Version, Generation, ProcessorCount, DynamicMemoryEnabled, @{ n = 'MemoryStartupMB'; e = { [int]($_.MemoryStartup / 1MB) } }, @{ n = 'MemoryAssignedMB'; e = { [int]($_.MemoryAssigned / 1MB) } }, @{ n = 'MemoryDemandMB'; e = { [int]($_.MemoryDemand / 1MB) } }, CheckpointType, AutomaticStartAction, AutomaticStopAction, IsClustered, ReplicationMode, ReplicationHealth | Format-List)
            Add-HcsSection 'Integration services'
            Add-HcsText (Get-VMIntegrationService -VM $vm | Select-Object Name, Enabled, PrimaryStatusDescription | Format-Table -AutoSize)
            Add-HcsSection 'Network adapters'
            Add-HcsText (Get-VMNetworkAdapter -VM $vm | Select-Object Name, SwitchName, MacAddress, Status, @{ n = 'IP'; e = { $_.IPAddresses -join ',' } }, @{ n = 'VLAN'; e = { ($_ | Get-VMNetworkAdapterVlan).OperationMode } } | Format-Table -AutoSize)
            Add-HcsSection 'Virtual hard disks and chain'
            foreach ($drive in Get-VMHardDiskDrive -VM $vm) {
                $lines.Add("  $($drive.ControllerType) $($drive.ControllerNumber):$($drive.ControllerLocation) $($drive.Path)")
                $path = $drive.Path
                while ($path) {
                    $vhd = Get-VHD -Path $path -ErrorAction SilentlyContinue
                    if ($null -eq $vhd) { break }
                    $lines.Add(("    {0} {1} size={2} GB file={3} GB parent={4}" -f $vhd.VhdFormat, $vhd.VhdType, [math]::Round($vhd.Size / 1GB, 1), [math]::Round($vhd.FileSize / 1GB, 1), $vhd.ParentPath))
                    $path = $vhd.ParentPath
                }
            }
            Add-HcsSection 'Checkpoints'
            Add-HcsText (Get-VMSnapshot -VM $vm -ErrorAction SilentlyContinue | Select-Object Name, SnapshotType, CreationTime, ParentSnapshotName | Format-Table -AutoSize)
        }
        'VmPerformance' {
            $vm = Get-HcsVm
            Add-HcsSection "Resource metering for $($vm.Name)"
            if (-not $vm.ResourceMeteringEnabled) { $lines.Add('Resource metering is not enabled for this VM (Enable-VMResourceMetering); showing live counters instead.') }
            else { Add-HcsText (Measure-VM -VM $vm | Format-List) }
            $counters = @("\Hyper-V Hypervisor Virtual Processor($($vm.Name -replace '[\\/()#]', '_'):Hv VP *)\% Total Run Time", '\Hyper-V Dynamic Memory VM(*)\Current Pressure')
            foreach ($c in $counters) { try { Add-HcsText ((Get-Counter -Counter $c -ErrorAction Stop).CounterSamples | Select-Object Path, CookedValue | Format-Table -AutoSize) } catch { } }
        }
        'VmReplica' {
            $vm = Get-HcsVm
            Add-HcsSection "Replication for $($vm.Name)"
            Add-HcsText (Get-VMReplication -VM $vm -ErrorAction SilentlyContinue | Format-List)
            Add-HcsText (Measure-VMReplication -VM $vm -ErrorAction SilentlyContinue | Format-List)
        }
        'RestartVmms' { Restart-Service -Name vmms -Force -ErrorAction Stop; Add-HcsText (Get-Service vmms | Format-Table -AutoSize) }
        'RestartVmCompute' { Restart-Service -Name vmcompute -Force -ErrorAction Stop; Add-HcsText (Get-Service vmcompute | Format-Table -AutoSize) }
        'StartVm' { $vm = Get-HcsVm; Start-VM -VM $vm -ErrorAction Stop; Add-HcsText (Get-VM -Id $vm.Id | Select-Object Name, State, Status | Format-Table -AutoSize) }
        'StopVm' { $vm = Get-HcsVm; Stop-VM -VM $vm -Force -ErrorAction Stop; Add-HcsText (Get-VM -Id $vm.Id | Select-Object Name, State, Status | Format-Table -AutoSize) }
        'SaveVm' { $vm = Get-HcsVm; Save-VM -VM $vm -ErrorAction Stop; Add-HcsText (Get-VM -Id $vm.Id | Select-Object Name, State, Status | Format-Table -AutoSize) }
        'ResumeVm' { $vm = Get-HcsVm; Resume-VM -VM $vm -ErrorAction Stop; Add-HcsText (Get-VM -Id $vm.Id | Select-Object Name, State, Status | Format-Table -AutoSize) }
        'RestartVm' { $vm = Get-HcsVm; Restart-VM -VM $vm -Force -ErrorAction Stop; Add-HcsText (Get-VM -Id $vm.Id | Select-Object Name, State, Status | Format-Table -AutoSize) }
        'MergeCheckpoints' {
            $vm = Get-HcsVm
            $checkpoints = @(Get-VMSnapshot -VM $vm -ErrorAction Stop)
            foreach ($checkpoint in $checkpoints) { Remove-VMSnapshot -VMSnapshot $checkpoint -ErrorAction Stop }
            $lines.Add("Removed $($checkpoints.Count) checkpoint(s); the merge continues in the background (VM status shows 'Merging disks').")
        }
        'CreateCheckpoint' { $vm = Get-HcsVm; $cp = Checkpoint-VM -VM $vm -SnapshotName ("SCOM task " + [DateTime]::UtcNow.ToString('yyyy-MM-dd HH:mm')) -Passthru -ErrorAction Stop; Add-HcsText ($cp | Select-Object Name, SnapshotType, CreationTime | Format-List) }
        'ResumeReplication' { $vm = Get-HcsVm; Resume-VMReplication -VM $vm -ErrorAction Stop; Add-HcsText (Get-VMReplication -VM $vm | Select-Object State, Health, LastReplicationTime | Format-List) }
        'MoveVmToBestNode' {
            $vm = Get-HcsVm
            if (-not (Import-HcsModule -Name 'FailoverClusters')) { throw 'FailoverClusters module unavailable; this task needs a clustered VM.' }
            $group = Get-ClusterResource -ErrorAction Stop | Where-Object { $_.ResourceType -eq 'Virtual Machine' -and ((Get-ClusterParameter -InputObject $_ -Name VmID -ErrorAction SilentlyContinue).Value -eq [string]$vm.Id) } | Select-Object -First 1 -ExpandProperty OwnerGroup
            if ($null -eq $group) { throw "VM '$($vm.Name)' is not a clustered role." }
            Add-HcsText (Move-ClusterVirtualMachineRole -Name $group.Name -MigrationType Live -ErrorAction Stop | Format-Table -AutoSize)
        }
        'TestDomainHealth' {
            Add-HcsSection 'Domain membership and secure channel'
            $cs = Get-CimInstance Win32_ComputerSystem -ErrorAction SilentlyContinue
            if ($null -ne $cs -and $cs.PartOfDomain) {
                $lines.Add("Domain: $($cs.Domain)")
                $lines.Add("Workgroup: $($cs.Workgroup)")
                try {
                    $channelOk = Test-ComputerSecureChannel -ErrorAction Stop
                    $lines.Add("Secure channel status: $(if ($channelOk) { 'OK' } else { 'FAILED' })")
                } catch {
                    $lines.Add("Secure channel test threw: $($_.Exception.Message)")
                }
                try {
                    $domainObj = [System.DirectoryServices.ActiveDirectory.Domain]::GetComputerDomain()
                    $lines.Add("Active Directory Forest: $($domainObj.Forest.Name)")
                    $lines.Add("PDC Emulator: $($domainObj.PdcRoleOwner.Name)")
                    $lines.Add("Domain Mode: $($domainObj.DomainMode)")
                } catch {
                    $lines.Add("Directory services query: $($_.Exception.Message)")
                }
                try {
                    $site = [System.DirectoryServices.ActiveDirectory.ActiveDirectorySite]::GetComputerSite().Name
                    $lines.Add("Assigned AD Site: $site")
                } catch {
                    $lines.Add("AD Site query: $($_.Exception.Message)")
                }
            } else {
                $lines.Add("Host is not joined to an Active Directory domain (Standalone / Workgroup).")
            }
        }
        'TestDnsResolution' {
            Add-HcsSection 'DNS client configuration'
            $dnsServers = @()
            if (Get-Command Get-DnsClientServerAddress -ErrorAction SilentlyContinue) {
                $adapters = @(Get-DnsClientServerAddress -AddressFamily IPv4 -ErrorAction SilentlyContinue | Where-Object { $_.ServerAddresses.Count -gt 0 })
                foreach ($ad in $adapters) {
                    $lines.Add("Interface $($ad.InterfaceAlias) ($($ad.InterfaceIndex)): $($ad.ServerAddresses -join ', ')")
                    $dnsServers += $ad.ServerAddresses
                }
            }
            $dnsServers = @($dnsServers | Select-Object -Unique)
            $lines.Add("Distinct DNS Servers configured: $(if ($dnsServers.Count) { $dnsServers -join ', ' } else { 'None' })")

            Add-HcsSection 'DNS name resolution tests'
            $targets = @($ComputerName, $env:COMPUTERNAME)
            if ($env:USERDNSDOMAIN) { $targets += $env:USERDNSDOMAIN }
            $cs = Get-CimInstance Win32_ComputerSystem -ErrorAction SilentlyContinue
            if ($null -ne $cs -and $cs.PartOfDomain -and $cs.Domain) { $targets += $cs.Domain }
            $targets = @($targets | Where-Object { -not [string]::IsNullOrWhiteSpace($_) } | Select-Object -Unique)

            foreach ($target in $targets) {
                $sw = [System.Diagnostics.Stopwatch]::StartNew()
                try {
                    $res = [System.Net.Dns]::GetHostEntry($target)
                    $sw.Stop()
                    $addrs = ($res.AddressList | ForEach-Object { $_.ToString() }) -join ', '
                    $lines.Add("  [OK] $target -> $addrs ($($sw.ElapsedMilliseconds) ms)")
                } catch {
                    $sw.Stop()
                    $lines.Add("  [FAIL] $target -> $($_.Exception.Message) ($($sw.ElapsedMilliseconds) ms)")
                }
            }

            if ($env:USERDNSDOMAIN) {
                Add-HcsSection "Active Directory SRV record tests for $($env:USERDNSDOMAIN)"
                $srvRecord = "_ldap._tcp.dc._msdcs.$($env:USERDNSDOMAIN)"
                try {
                    if (Get-Command Resolve-DnsName -ErrorAction SilentlyContinue) {
                        $srvResults = @(Resolve-DnsName -Name $srvRecord -Type SRV -ErrorAction Stop)
                        foreach ($srv in $srvResults) {
                            $lines.Add("  DC: $($srv.NameTarget):$($srv.Port) (Priority: $($srv.Priority), Weight: $($srv.Weight))")
                        }
                    } else {
                        $lines.Add("  Resolve-DnsName cmdlet not available.")
                    }
                } catch {
                    $lines.Add("  [FAIL] Querying $($srvRecord): $($_.Exception.Message)")
                }
            }
        }
        'TestPortConnectivity' {
            Add-HcsSection 'Port connectivity diagnostics'
            $endpoints = [System.Collections.Generic.List[object]]::new()
            if (-not [string]::IsNullOrWhiteSpace($Parameter)) {
                if ($Parameter.Contains(':')) {
                    $parts = $Parameter -split ':', 2
                    $endpoints.Add([pscustomobject]@{ Host = $parts[0].Trim(); Port = [int]$parts[1].Trim(); Label = 'User-specified target' })
                } else {
                    $endpoints.Add([pscustomobject]@{ Host = $Parameter.Trim(); Port = 445; Label = 'SMB (default port)' })
                }
            } else {
                $gw = Get-CimInstance Win32_NetworkAdapterConfiguration -Filter "IPEnabled = TRUE" -ErrorAction SilentlyContinue | Where-Object { $null -ne $_.DefaultIPGateway } | Select-Object -ExpandProperty DefaultIPGateway -First 1
                if ($gw) {
                    $endpoints.Add([pscustomobject]@{ Host = $gw; Port = 445; Label = 'Default Gateway (SMB port probe)' })
                    $endpoints.Add([pscustomobject]@{ Host = $gw; Port = 80; Label = 'Default Gateway (HTTP/Mgmt)' })
                    $endpoints.Add([pscustomobject]@{ Host = $gw; Port = 443; Label = 'Default Gateway (HTTPS/Firewall)' })
                }
                $dcHost = $null
                try {
                    $domainObj = [System.DirectoryServices.ActiveDirectory.Domain]::GetComputerDomain()
                    $dcHost = $domainObj.PdcRoleOwner.Name
                } catch {}
                if ($dcHost) {
                    $endpoints.Add([pscustomobject]@{ Host = $dcHost; Port = 135; Label = 'DC RPC Endpoint Mapper' })
                    $endpoints.Add([pscustomobject]@{ Host = $dcHost; Port = 389; Label = 'DC LDAP' })
                    $endpoints.Add([pscustomobject]@{ Host = $dcHost; Port = 636; Label = 'DC LDAPS' })
                    $endpoints.Add([pscustomobject]@{ Host = $dcHost; Port = 88; Label = 'DC Kerberos' })
                    $endpoints.Add([pscustomobject]@{ Host = $dcHost; Port = 445; Label = 'DC SMB' })
                    $endpoints.Add([pscustomobject]@{ Host = $dcHost; Port = 5985; Label = 'DC WinRM HTTP' })
                }
                $endpoints.Add([pscustomobject]@{ Host = '127.0.0.1'; Port = 5723; Label = 'SCOM Management Server (local test)' })
            }

            foreach ($ep in $endpoints) {
                $client = [System.Net.Sockets.TcpClient]::new()
                $sw = [System.Diagnostics.Stopwatch]::StartNew()
                try {
                    $connectAsync = $client.BeginConnect($ep.Host, $ep.Port, $null, $null)
                    $success = $connectAsync.AsyncWaitHandle.WaitOne(3000, $false)
                    $sw.Stop()
                    if ($success -and $client.Connected) {
                        $client.EndConnect($connectAsync)
                        $lines.Add("  [OPEN] $($ep.Host):$($ep.Port) ($($ep.Label)) in $($sw.ElapsedMilliseconds) ms")
                    } else {
                        $lines.Add("  [CLOSED/TIMEOUT] $($ep.Host):$($ep.Port) ($($ep.Label)) after $($sw.ElapsedMilliseconds) ms")
                    }
                } catch {
                    $sw.Stop()
                    $lines.Add("  [FAIL] $($ep.Host):$($ep.Port) ($($ep.Label)): $($_.Exception.Message)")
                } finally {
                    $client.Dispose()
                }
            }
        }
        'TestPxeWdsHealth' {
            Add-HcsSection 'Bare-metal PXE and Windows Deployment Services health'
            $wds = Get-Service -Name 'WDSServer' -ErrorAction SilentlyContinue
            if ($null -eq $wds) {
                $lines.Add("Windows Deployment Services (WDSServer) is not installed on this host.")
            } else {
                $lines.Add("WDSServer Status: $($wds.Status)")
                $lines.Add("WDSServer StartType: $($wds.StartType)")

                Add-HcsSection 'PXE / TFTP UDP listeners'
                try {
                    if (Get-Command Get-NetUDPEndpoint -ErrorAction SilentlyContinue) {
                        $endpoints = @(Get-NetUDPEndpoint -ErrorAction SilentlyContinue | Where-Object { $_.LocalPort -in @(67, 68, 69, 4011) })
                        if ($endpoints.Count) {
                            $lines.Add(($endpoints | Select-Object LocalAddress, LocalPort | Format-Table -AutoSize | Out-String).TrimEnd())
                        } else {
                            $lines.Add("No active listeners found on PXE/TFTP ports (67, 68, 69, 4011).")
                        }
                    }
                } catch {
                    $lines.Add("Unable to query UDP endpoints: $($_.Exception.Message)")
                }

                Add-HcsSection 'Remote Installation Folder (REMINST)'
                $reminstShare = Get-CimInstance Win32_Share -Filter "Name = 'REMINST'" -ErrorAction SilentlyContinue
                if ($reminstShare) {
                    $lines.Add("REMINST share path: $($reminstShare.Path)")
                    $lines.Add("REMINST share exists on disk: $(Test-Path -LiteralPath $reminstShare.Path)")
                } else {
                    $lines.Add("REMINST share not found.")
                }
            }
        }
        'TestChassisBmcConnectivity' {
            Add-HcsSection 'Server chassis hardware and BMC connectivity'
            $csProduct = Get-CimInstance Win32_ComputerSystemProduct -ErrorAction SilentlyContinue
            $system = Get-CimInstance Win32_ComputerSystem -ErrorAction SilentlyContinue
            $bios = Get-CimInstance Win32_BIOS -ErrorAction SilentlyContinue
            $lines.Add("  Manufacturer: $(if ($csProduct) { $csProduct.Vendor } else { 'Unknown' })")
            $lines.Add("  Model:        $(if ($csProduct) { $csProduct.Name } else { 'Unknown' })")
            $lines.Add("  Serial/UUID:  $(if ($csProduct) { $csProduct.IdentifyingNumber } else { 'Unknown' })")
            $lines.Add("  BIOS Version: $(if ($bios) { $bios.SMBIOSBIOSVersion } else { 'Unknown' })")
            $lines.Add("  Chassis State: $(if ($system -and $system.Status) { $system.Status } else { 'OK' })")

            Add-HcsSection 'BMC / Out-of-band management connectivity'
            $bmcTarget = if (-not [string]::IsNullOrWhiteSpace($Parameter)) { $Parameter.Trim() } else { $null }
            if ($null -eq $bmcTarget) {
                try {
                    $ipmi = Get-CimInstance -Namespace 'root\hardware' -ClassName 'IPMI_IPMIPROVIDER' -ErrorAction SilentlyContinue
                    if ($ipmi -and $ipmi.IPv4Address) { $bmcTarget = $ipmi.IPv4Address }
                } catch {}
            }
            if ($null -ne $bmcTarget) {
                $lines.Add("  Target BMC IP: $bmcTarget")
                $ping = Test-Connection -TargetName $bmcTarget -Count 1 -TimeoutSeconds 2 -Quiet -ErrorAction SilentlyContinue
                $lines.Add("  Ping (ICMP): $(if ($ping) { '[SUCCESS] Responded' } else { '[WARNING] No response' })")
                foreach ($port in @(443, 623)) {
                    $client = [System.Net.Sockets.TcpClient]::new()
                    try {
                        $async = $client.BeginConnect($bmcTarget, $port, $null, $null)
                        $connected = $async.AsyncWaitHandle.WaitOne(2000, $false)
                        if ($connected -and $client.Connected) {
                            $client.EndConnect($async)
                            $lines.Add("  Port $port (TCP): [OPEN]")
                        } else {
                            $lines.Add("  Port $port (TCP): [CLOSED/FILTERED]")
                        }
                    } catch {
                        $lines.Add("  Port $port (TCP): [FAIL] $($_.Exception.Message)")
                    } finally {
                        $client.Dispose()
                    }
                }
            } else {
                $lines.Add("  No BMC IP specified in task parameter and IPMI CIM provider not registered.")
                $lines.Add("  (Tip: Supply the BMC/iDRAC/iLO IP address as the task parameter to probe directly).")
            }
        }
        'TestNetworkSwitchConnectivity' {
            Add-HcsSection 'Physical uplinks and switch neighbor connectivity'
            $adapters = Get-NetAdapter -Physical -ErrorAction SilentlyContinue | Sort-Object Name
            foreach ($nic in $adapters) {
                $lines.Add("  Adapter: $($nic.Name) | Status: $($nic.Status) | Speed: $($nic.LinkSpeed) | MAC: $($nic.MacAddress)")
            }

            Add-HcsSection 'LLDP / CDP neighbor discovery'
            $lldpFound = $false
            if (Get-Command Get-NetLldpAgent -ErrorAction SilentlyContinue) {
                try {
                    $agents = Get-NetLldpAgent -ErrorAction SilentlyContinue
                    if ($agents) {
                        $lldpFound = $true
                        foreach ($agent in $agents) {
                            $lines.Add("  LLDP Agent on $($agent.InterfaceAlias) [Address: $($agent.ChassisId)] Mode: $($agent.AdminStatus)")
                        }
                    }
                } catch {}
            }
            if (-not $lldpFound) {
                $lines.Add("  LLDP agent query returned no active neighbors or Data Center Bridging (DCB) is not enabled.")
            }

            Add-HcsSection 'Default gateway reachability'
            $gw = Get-CimInstance Win32_NetworkAdapterConfiguration -Filter "IPEnabled = TRUE" -ErrorAction SilentlyContinue | Where-Object { $null -ne $_.DefaultIPGateway } | Select-Object -ExpandProperty DefaultIPGateway -First 1
            if ($gw) {
                $ping = Test-Connection -TargetName $gw -Count 2 -TimeoutSeconds 2 -ErrorAction SilentlyContinue
                if ($ping) {
                    $avgTime = ($ping | Measure-Object -Property ResponseTime -Average).Average
                    $lines.Add("  [PASS] Default Gateway ($gw) responded in average $($avgTime) ms.")
                } else {
                    $lines.Add("  [FAIL] Default Gateway ($gw) did not respond to ICMP ping.")
                }
            } else {
                $lines.Add("  No default gateway configured on active adapters.")
            }
        }
        'TestFirewallGateway' {
            Add-HcsSection 'Perimeter edge firewall and gateway diagnostics'
            $gw = if (-not [string]::IsNullOrWhiteSpace($Parameter)) { $Parameter.Trim() } else {
                Get-CimInstance Win32_NetworkAdapterConfiguration -Filter "IPEnabled = TRUE" -ErrorAction SilentlyContinue | Where-Object { $null -ne $_.DefaultIPGateway } | Select-Object -ExpandProperty DefaultIPGateway -First 1
            }
            if ($gw) {
                $lines.Add("  Firewall / Gateway Target: $gw")
                $ping = Test-Connection -TargetName $gw -Count 3 -TimeoutSeconds 2 -ErrorAction SilentlyContinue
                if ($ping) {
                    $avg = ($ping | Measure-Object -Property ResponseTime -Average).Average
                    $lines.Add("  [PASS] Gateway ping successful. Average latency: $avg ms.")
                } else {
                    $lines.Add("  [FAIL] Gateway did not respond to ICMP echo.")
                }

                foreach ($port in @(80, 443, 8443)) {
                    $client = [System.Net.Sockets.TcpClient]::new()
                    try {
                        $async = $client.BeginConnect($gw, $port, $null, $null)
                        $ok = $async.AsyncWaitHandle.WaitOne(2000, $false)
                        if ($ok -and $client.Connected) {
                            $client.EndConnect($async)
                            $lines.Add("  Management Port $port (TCP): [REACHABLE]")
                        } else {
                            $lines.Add("  Management Port $port (TCP): [FILTERED / CLOSED]")
                        }
                    } catch {
                        $lines.Add("  Management Port $port (TCP): [ERROR] $($_.Exception.Message)")
                    } finally {
                        $client.Dispose()
                    }
                }
            } else {
                $lines.Add("  No gateway IP found and no target parameter provided.")
            }
        }
        'TestOpengearPort' {
            Add-HcsSection 'Out-of-band console server (Opengear) reachability'
            $ogTarget = if (-not [string]::IsNullOrWhiteSpace($Parameter)) { $Parameter.Trim() } else { '192.168.0.1' }
            $lines.Add("  Opengear Target IP: $ogTarget")
            $ping = Test-Connection -TargetName $ogTarget -Count 2 -TimeoutSeconds 2 -ErrorAction SilentlyContinue
            if ($ping) {
                $lines.Add("  [PASS] Opengear console server responded to ICMP echo.")
            } else {
                $lines.Add("  [WARNING] Opengear console server did not respond to ICMP echo.")
            }

            foreach ($port in @(22, 443)) {
                $client = [System.Net.Sockets.TcpClient]::new()
                try {
                    $async = $client.BeginConnect($ogTarget, $port, $null, $null)
                    $ok = $async.AsyncWaitHandle.WaitOne(2000, $false)
                    if ($ok -and $client.Connected) {
                        $client.EndConnect($async)
                        $lines.Add("  Service Port $port ($(if ($port -eq 22) { 'SSH' } else { 'HTTPS' })): [OPEN]")
                    } else {
                        $lines.Add("  Service Port $port ($(if ($port -eq 22) { 'SSH' } else { 'HTTPS' })): [CLOSED / UNREACHABLE]")
                    }
                } catch {
                    $lines.Add("  Service Port ${port}: [FAIL] $($_.Exception.Message)")
                } finally {
                    $client.Dispose()
                }
            }
            $lines.Add("  (Tip: Supply the Opengear appliance IP as task parameter to test a specific console server).")
        }
        'TestDhcpScopeHealth' {
            Add-HcsSection 'DHCP infrastructure service and scope status'
            $dhcpSvc = Get-Service -Name 'DHCPServer' -ErrorAction SilentlyContinue
            if ($null -eq $dhcpSvc) {
                $lines.Add("  DHCP Server service (DHCPServer) is not installed on this host.")
                $lines.Add("  This node consumes DHCP from an external router, firewall, or appliance.")
            } else {
                $lines.Add("  Service Status: $($dhcpSvc.Status)")
                $lines.Add("  Startup Type:   $($dhcpSvc.StartType)")

                if (Get-Command Get-DhcpServerv4Scope -ErrorAction SilentlyContinue) {
                    try {
                        $scopes = Get-DhcpServerv4Scope -ErrorAction SilentlyContinue
                        if ($scopes) {
                            Add-HcsSection 'IPv4 DHCP scopes'
                            foreach ($scope in $scopes) {
                                $stats = Get-DhcpServerv4ScopeStatistics -ScopeId $scope.ScopeId -ErrorAction SilentlyContinue
                                $lines.Add("  Scope: $($scope.ScopeId) ($($scope.Name)) - State: $($scope.State)")
                                $lines.Add("    Subnet: $($scope.SubnetMask) | Range: $($scope.StartRange) - $($scope.EndRange)")
                                if ($stats) {
                                    $lines.Add("    Addresses: Total=$($stats.TotalAddresses), InUse=$($stats.InUse), Free=$($stats.Free), PercentInUse=$([math]::Round($stats.PercentageInUse, 1))%")
                                }
                            }
                        } else {
                            $lines.Add("  No active IPv4 scopes configured on this DHCP server.")
                        }
                    } catch {
                        $lines.Add("  Error querying DHCP scopes: $($_.Exception.Message)")
                    }
                } else {
                    $lines.Add("  DhcpServer module cmdlets not available.")
                }
            }
        }
    }
}
catch {
    $lines.Add("FAILED: $($_.Exception.Message)")
}
$lines -join [Environment]::NewLine
