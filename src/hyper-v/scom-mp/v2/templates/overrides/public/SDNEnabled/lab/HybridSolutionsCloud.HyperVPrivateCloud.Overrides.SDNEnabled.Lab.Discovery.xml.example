  <Manifest>
    <Identity><ID>HybridSolutionsCloud.HyperVPrivateCloud.Overrides.SDNEnabled.Lab.Discovery</ID><Version>{{VERSION}}</Version></Identity>
    <Name>Hyper-V Private Cloud Monitoring - SDNEnabled Lab Discovery Overrides</Name>
    <References>
      <Reference Alias="Windows"><ID>Microsoft.Windows.Library</ID><Version>7.5.8501.0</Version><PublicKeyToken>31bf3856ad364e35</PublicKeyToken></Reference>
      <Reference Alias="HCSV2Library"><ID>HybridSolutionsCloud.HyperVPrivateCloud.Library</ID><Version>{{PRODUCT_VERSION}}</Version><PublicKeyToken>{{PUBLIC_KEY_TOKEN}}</PublicKeyToken></Reference>
      <Reference Alias="HCSV2Discovery"><ID>HybridSolutionsCloud.HyperVPrivateCloud.Discovery</ID><Version>{{PRODUCT_VERSION}}</Version><PublicKeyToken>{{PUBLIC_KEY_TOKEN}}</PublicKeyToken></Reference>
      <Reference Alias="HCSV2SDN"><ID>HybridSolutionsCloud.HyperVPrivateCloud.Capability.SDN</ID><Version>{{PRODUCT_VERSION}}</Version><PublicKeyToken>{{PUBLIC_KEY_TOKEN}}</PublicKeyToken></Reference>
    </References>
  </Manifest>
  <Monitoring>
    <Overrides>
      <DiscoveryConfigurationOverride ID="HybridSolutionsCloud.HyperVPrivateCloud.Overrides.SDNEnabled.Lab.Discovery.Core.Seed.Frequency.HostRoleSeed.Override" Context="Windows!Microsoft.Windows.Server.OperatingSystem" Enforced="false" Discovery="HCSV2Discovery!HybridSolutionsCloud.HyperVPrivateCloud.HostRole.Seed.Discovery" Module="RegistrySeed" Parameter="Frequency"><Value>3600</Value></DiscoveryConfigurationOverride>
      <DiscoveryConfigurationOverride ID="HybridSolutionsCloud.HyperVPrivateCloud.Overrides.SDNEnabled.Lab.Discovery.Core.Topology.Interval.Topology.Override" Context="HCSV2Library!HybridSolutionsCloud.HyperVPrivateCloud.HostRole" Enforced="false" Discovery="HCSV2Discovery!HybridSolutionsCloud.HyperVPrivateCloud.Topology.Discovery" Module="PowerShellDiscovery" Parameter="IntervalSeconds"><Value>300</Value></DiscoveryConfigurationOverride>
      <DiscoveryConfigurationOverride ID="HybridSolutionsCloud.HyperVPrivateCloud.Overrides.SDNEnabled.Lab.Discovery.SDN.Discovery.Interval.Relationships.Override" Context="HCSV2Library!HybridSolutionsCloud.HyperVPrivateCloud.HostRole" Enforced="false" Discovery="HCSV2SDN!HybridSolutionsCloud.HyperVPrivateCloud.Capability.SDN.Relationship.Discovery" Module="PowerShellDiscovery" Parameter="IntervalSeconds"><Value>300</Value></DiscoveryConfigurationOverride>
    </Overrides>
  </Monitoring>
  <LanguagePacks><LanguagePack ID="ENU" IsDefault="true"><DisplayStrings>
        <DisplayString ElementID="HybridSolutionsCloud.HyperVPrivateCloud.Overrides.SDNEnabled.Lab.Discovery"><Name>Hyper-V Private Cloud Monitoring - SDNEnabled Lab Discovery Overrides</Name><Description>Unsealed, customer-owned Lab starter overrides for the SDNEnabled deployment profile. Review in a test management group, customize locally, and export after every change.</Description></DisplayString>
      </DisplayStrings></LanguagePack></LanguagePacks>
