#Requires -Version 7.0
Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'
$WarningPreference = 'SilentlyContinue'
if (-not (Get-Command -Name 'Get-VMHost' -ErrorAction SilentlyContinue)) {
    if (Get-Module -ListAvailable -Name 'Hyper-V' -ErrorAction SilentlyContinue) { Import-Module -Name 'Hyper-V' -ErrorAction SilentlyContinue -WarningAction SilentlyContinue }
}
if (-not (Get-Command -Name 'Get-VMHost' -ErrorAction SilentlyContinue)) {
    throw 'The Hyper-V PowerShell module is unavailable. Install Hyper-V-PowerShell with Install-WindowsFeature Hyper-V -IncludeManagementTools.'
}
$hostData = Get-VMHost
$vms = @(Get-VM)
$switches = @(Get-VMSwitch)
$oldCheckpoints = @($vms | Get-VMSnapshot -ErrorAction SilentlyContinue | Where-Object CreationTime -lt (Get-Date).AddDays(-7))
$automationAssembly = [System.Management.Automation.PSObject].Assembly
$process = Get-Process -Id $PID
[pscustomobject]@{
    Computer = $env:COMPUTERNAME
    PSEdition = $PSVersionTable.PSEdition
    PowerShellVersion = $PSVersionTable.PSVersion.ToString()
    PowerShellProcessPath = $process.Path
    PowerShellHome = $PSHOME
    AutomationAssemblyLocation = $automationAssembly.Location
    AutomationAssemblyVersion = $automationAssembly.GetName().Version.ToString()
    Is64BitProcess = [Environment]::Is64BitProcess
    HyperVHostName = $hostData.Name
    HypervisorPresent = $(try { [bool](Get-CimInstance -ClassName 'Win32_ComputerSystem').HypervisorPresent } catch { 'unknown' })
    VmmsVersion = $(try { (Get-Item -LiteralPath (Join-Path $env:SystemRoot 'System32\vmms.exe') -ErrorAction Stop).VersionInfo.ProductVersion } catch { 'unknown' })
    SupportedVmVersions = ($hostData.SupportedVmVersions -join ', ')
    VirtualMachines = $vms.Count
    RunningVirtualMachines = @($vms | Where-Object State -eq 'Running').Count
    VirtualSwitches = $switches.Count
    ReplicationWarnings = @(Get-VMReplication -ErrorAction SilentlyContinue | Where-Object Health -ne 'Normal').Count
    CheckpointsOlderThanSevenDays = $oldCheckpoints.Count
    GeneratedUtc = [DateTime]::UtcNow.ToString('o')
} | Format-List | Out-String
