  </DisplayStrings><KnowledgeArticles><KnowledgeArticle ElementID="HyperVPrivateCloud.Capability.S2D.IntegrationHealth.Monitor" Visible="true"><MamlContent><maml:section xmlns:maml="http://schemas.microsoft.com/maml/2004/10"><maml:title>Summary</maml:title><maml:para>Verifies that the Windows Storage query path used by the HCS S2D adapter is operational. Microsoft S2D workflows remain the leaf-alert authority.</maml:para></maml:section><maml:section xmlns:maml="http://schemas.microsoft.com/maml/2004/10"><maml:title>Operator response</maml:title><maml:para>Validate the Storage module, HealthService account permissions, Microsoft S2D discovery, and Operations Manager event 8503.</maml:para></maml:section></MamlContent></KnowledgeArticle></KnowledgeArticles></LanguagePack></LanguagePacks>
