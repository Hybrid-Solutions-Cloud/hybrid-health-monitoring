#Requires -Version 7.0
param([string]$ArrayId)

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'
$WarningPreference = 'SilentlyContinue'

function Import-HcsOperationsManagerSdk {
    $roots = @(
        (Join-Path $env:ProgramFiles 'Microsoft System Center\Operations Manager\Server\SDK Binaries'),
        (Join-Path $env:ProgramFiles 'Microsoft System Center\Management Pack Tools'),
        (Join-Path ${env:ProgramFiles(x86)} 'Microsoft System Center\Operations Manager\Console\SDK Binaries')
    )
    foreach ($root in $roots) {
        $core = Join-Path $root 'Microsoft.EnterpriseManagement.Core.dll'
        $operations = Join-Path $root 'Microsoft.EnterpriseManagement.OperationsManager.dll'
        if ((Test-Path -LiteralPath $core -PathType Leaf) -and (Test-Path -LiteralPath $operations -PathType Leaf)) {
            [void][Reflection.Assembly]::LoadFrom($core)
            [void][Reflection.Assembly]::LoadFrom($operations)
            return $true
        }
    }
    return $false
}

function Get-HcsObjectValue {
    param($Object, [string]$PropertyName)
    $value = $Object.Values | Where-Object { $_.Type.Name -eq $PropertyName } | Select-Object -First 1
    if ($null -eq $value -or $null -eq $value.Value) { return '' }
    return [string]$value.Value
}

function Get-HcsParentValue {
    param($Object, [string]$PropertyName)
    foreach ($parent in $Object.GetParentMonitoringObjects()) {
        $value = Get-HcsObjectValue $parent $PropertyName
        if (-not [string]::IsNullOrWhiteSpace($value)) { return $value }
    }
    return ''
}

function Get-HcsClassObject {
    param($ManagementGroup, $ManagementPack, [string]$ClassName)
    return @($ManagementGroup.GetMonitoringObjects($ManagementGroup.GetMonitoringClass($ClassName, $ManagementPack)))
}

function ConvertTo-HcsIdentifier {
    param([string]$Value)
    $result = [System.Collections.Generic.HashSet[string]]::new([StringComparer]::OrdinalIgnoreCase)
    foreach ($match in [regex]::Matches($Value, 'iqn\.[^,;\s]+', 'IgnoreCase')) { [void]$result.Add($match.Value.ToLowerInvariant()) }
    foreach ($part in @($Value -split '[,;\s]+')) { $hex = ($part -replace '[^0-9a-fA-F]', '').ToLowerInvariant(); if ($hex.Length -ge 16) { [void]$result.Add($hex) } }
    return $result
}

function ConvertTo-HcsSerial { param([string]$Value); return ($Value -replace '[^0-9a-zA-Z]', '').ToLowerInvariant() }

$api = New-Object -ComObject 'MOM.ScriptAPI'
$bag = $api.CreatePropertyBag()
$state = 'Good'
$detail = 'Pure Storage correlation is operational.'

try {
    if (-not (Import-HcsOperationsManagerSdk)) { throw 'Operations Manager SDK assemblies were not found.' }
    $managementGroup = [Microsoft.EnterpriseManagement.ManagementGroup]::new($env:COMPUTERNAME)
    try {
        $pureMp = @($managementGroup.GetManagementPacks('PureStorageFlashArray') | Sort-Object Version -Descending)[0]
        $storageMp = @($managementGroup.GetManagementPacks('HyperVPrivateCloud.Capability.Storage') | Sort-Object Version -Descending)[0]
        $hcsIds = [System.Collections.Generic.HashSet[string]]::new([StringComparer]::OrdinalIgnoreCase)
        foreach ($className in @('HyperVPrivateCloud.Capability.Storage.IscsiSession', 'HyperVPrivateCloud.Capability.Storage.FibreChannelPort')) {
            foreach ($object in (Get-HcsClassObject $managementGroup $storageMp $className)) {
                $property = if ($className.EndsWith('IscsiSession')) { 'InitiatorNodeAddress' } else { 'WWPN' }
                foreach ($identifier in (ConvertTo-HcsIdentifier (Get-HcsObjectValue $object $property))) { [void]$hcsIds.Add($identifier) }
            }
        }
        $hcsSerials = [System.Collections.Generic.HashSet[string]]::new([StringComparer]::OrdinalIgnoreCase)
        foreach ($lun in (Get-HcsClassObject $managementGroup $storageMp 'HyperVPrivateCloud.Capability.Storage.LogicalUnit')) {
            $serial = ConvertTo-HcsSerial (Get-HcsObjectValue $lun 'SerialNumber')
            if (-not [string]::IsNullOrWhiteSpace($serial)) { [void]$hcsSerials.Add($serial) }
        }
        $hostMatches = 0
        foreach ($pureHost in (Get-HcsClassObject $managementGroup $pureMp 'PureStorage.FlashArray.PureHost')) {
            if ((Get-HcsParentValue $pureHost 'ArrayId') -ne $ArrayId) { continue }
            $matched = $false
            foreach ($property in @('IQN', 'WWN')) { foreach ($id in (ConvertTo-HcsIdentifier (Get-HcsObjectValue $pureHost $property))) { if ($hcsIds.Contains($id)) { $matched = $true } } }
            if ($matched) { $hostMatches++ }
        }
        $volumeMatches = 0
        foreach ($volume in (Get-HcsClassObject $managementGroup $pureMp 'PureStorage.FlashArray.PureVolume')) {
            if ((Get-HcsParentValue $volume 'ArrayId') -ne $ArrayId) { continue }
            if ($hcsSerials.Contains((ConvertTo-HcsSerial (Get-HcsObjectValue $volume 'Serial')))) { $volumeMatches++ }
        }
        if (($hostMatches + $volumeMatches) -eq 0) {
            $state = 'NotApplicable'
            $detail = "Pure array '$ArrayId' has no exact IQN, WWPN, or volume-serial match to an HCS-discovered Hyper-V storage object. It is not attached to a private-cloud boundary."
        }
        else {
            $detail = "Pure array '$ArrayId' has $hostMatches host-initiator match(es) and $volumeMatches volume-serial match(es)."
        }
    }
    finally { $managementGroup.Dispose() }
}
catch {
    $state = 'Critical'
    $detail = "Pure Storage correlation query failed: $($_.Exception.Message)"
    $api.LogScriptEvent('HyperVPrivateCloud.PureStorage.IntegrationHealth.ps1', 8603, 1, $detail)
}

$bag.AddValue('PureIntegrationState', $state)
$bag.AddValue('PureIntegrationStateDetail', $detail)
$api.Return($bag)
