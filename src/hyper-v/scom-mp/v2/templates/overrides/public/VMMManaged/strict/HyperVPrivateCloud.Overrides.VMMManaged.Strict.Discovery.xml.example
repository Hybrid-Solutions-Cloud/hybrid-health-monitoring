  <Monitoring>
    <Overrides>
      <DiscoveryConfigurationOverride ID="HyperVPrivateCloud.Overrides.VMMManaged.Strict.Discovery.Core.Seed.Frequency.HostRoleSeed.Override" Context="Windows!Microsoft.Windows.Server.OperatingSystem" Enforced="false" Discovery="HCSV2Discovery!HyperVPrivateCloud.HostRole.Seed.Discovery" Module="RegistrySeed" Parameter="Frequency"><Value>7200</Value></DiscoveryConfigurationOverride>
      <DiscoveryConfigurationOverride ID="HyperVPrivateCloud.Overrides.VMMManaged.Strict.Discovery.Core.Topology.Interval.Topology.Override" Context="HCSV2Library!HyperVPrivateCloud.HostRole" Enforced="false" Discovery="HCSV2Discovery!HyperVPrivateCloud.Topology.Discovery" Module="PowerShellDiscovery" Parameter="IntervalSeconds"><Value>900</Value></DiscoveryConfigurationOverride>
      <DiscoveryConfigurationOverride ID="HyperVPrivateCloud.Overrides.VMMManaged.Strict.Discovery.VMM.Discovery.Interval.CloudRelationships.Override" Context="VMMDiscovery!Microsoft.SystemCenter.VirtualMachineManager.Discovery.PrivateCloud" Enforced="false" Discovery="HCSV2VMM!HyperVPrivateCloud.Capability.VMM.Cloud.Relationship.Discovery" Module="PowerShellDiscovery" Parameter="IntervalSeconds"><Value>3600</Value></DiscoveryConfigurationOverride>
      <DiscoveryConfigurationOverride ID="HyperVPrivateCloud.Overrides.VMMManaged.Strict.Discovery.VMM.Discovery.Interval.Fabric.Override" Context="VMMDiscovery!Microsoft.SystemCenter.VirtualMachineManager.Discovery.VMMManagementServer" Enforced="false" Discovery="HCSV2VMM!HyperVPrivateCloud.Capability.VMM.Fabric.Discovery" Module="PowerShellDiscovery" Parameter="IntervalSeconds"><Value>3600</Value></DiscoveryConfigurationOverride>
      <DiscoveryConfigurationOverride ID="HyperVPrivateCloud.Overrides.VMMManaged.Strict.Discovery.VMM.Discovery.Interval.HostRelationships.Override" Context="VMMDiscovery!Microsoft.SystemCenter.VirtualMachineManager.Discovery.HyperVHost" Enforced="false" Discovery="HCSV2VMM!HyperVPrivateCloud.Capability.VMM.Host.Relationship.Discovery" Module="PowerShellDiscovery" Parameter="IntervalSeconds"><Value>3600</Value></DiscoveryConfigurationOverride>
    </Overrides>
  </Monitoring>
  <LanguagePacks><LanguagePack ID="ENU" IsDefault="true"><DisplayStrings>
        <DisplayString ElementID="HyperVPrivateCloud.Overrides.VMMManaged.Strict.Discovery"><Name>Hyper-V Private Cloud Monitoring - VMMManaged Strict Discovery Overrides</Name><Description>Unsealed, customer-owned Strict starter overrides for the VMMManaged deployment profile. Review in a test management group, customize locally, and export after every change.</Description></DisplayString>
      </DisplayStrings></LanguagePack></LanguagePacks>
