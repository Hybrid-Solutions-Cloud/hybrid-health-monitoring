      "status": "ContractSpikeRequired",
      "optional": true
    },
    {
      "id": "SoftwareDefinedNetworking",
      "status": "ContractSpikeRequired",
      "optional": true
    },
    {
      "id": "ScaleOutFileServer",
      "status": "ContractSpikeRequired",
      "optional": true
    },
    {
      "id": "PhysicalNetwork",
      "status": "ContractSpikeRequired",
      "optional": true
    }
  ]
