  <LanguagePacks><LanguagePack ID="ENU" IsDefault="true"><DisplayStrings>{{ELEMENT_DISPLAY_STRINGS}}{{PHYSICAL_NETWORK_DISPLAY_STRINGS}}</DisplayStrings><KnowledgeArticles><KnowledgeArticle ElementID="HyperVPrivateCloud.Capability.PhysicalNetwork.IntegrationHealth.Monitor" Visible="true"><MamlContent><maml:section xmlns:maml="http://schemas.microsoft.com/maml/2004/10"><maml:title>Summary</maml:title><maml:para>Verifies that each external Hyper-V virtual switch uplink exposes the stable Windows adapter identity and MAC address used by SCOM network topology correlation.</maml:para></maml:section><maml:section xmlns:maml="http://schemas.microsoft.com/maml/2004/10"><maml:title>Operator response</maml:title><maml:para>Verify Hyper-V PowerShell management tools, physical adapter state, stable MAC addresses, and SCOM network discovery. Confirm that the built-in network diagram connects the Windows adapter to the expected switch port before relying on service-impact traversal.</maml:para></maml:section></MamlContent></KnowledgeArticle></KnowledgeArticles></LanguagePack></LanguagePacks>
