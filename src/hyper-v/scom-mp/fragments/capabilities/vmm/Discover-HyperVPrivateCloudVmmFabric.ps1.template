#Requires -Version 7.0
param(
    [string]$SourceId,
    [string]$ManagedEntityId,
    [string]$ComputerName
)

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'
$WarningPreference = 'SilentlyContinue'

function Add-HcsProperty {
    param($Instance, [string]$Property, $Value)
    if (-not [string]::IsNullOrWhiteSpace([string]$Value)) {
        $Instance.AddProperty($Property, [string]$Value)
    }
}

function Add-HcsRelationship {
    param([string]$TypeId, $Source, $Target)
    $relationship = $script:DiscoveryData.CreateRelationshipInstance($TypeId)
    $relationship.Source = $Source
    $relationship.Target = $Target
    $script:DiscoveryData.AddInstance($relationship)
}

function Get-HcsObjectProperty {
    param($InputObject, [string]$Name, $DefaultValue = '')
    if ($null -eq $InputObject) { return $DefaultValue }
    $property = $InputObject.PSObject.Properties[$Name]
    if ($null -eq $property -or $null -eq $property.Value) { return $DefaultValue }
    return $property.Value
}

function Get-HcsFabricBoundaryId {
    param([string]$VmmServer)
    return 'vmm:{0}' -f $VmmServer.Trim().ToLowerInvariant()
}

function Complete-HcsFabricComponent {
    param(
        $Service,
        $Component,
        [string]$RelationshipType,
        [string]$BoundaryId,
        [string]$DisplayName
    )

    Add-HcsProperty $Component "$MPElement[Name='HCSV2Library!HyperVPrivateCloud.ComponentGroup']/BoundaryId$" $BoundaryId
    Add-HcsProperty $Component "$MPElement[Name='System!System.Entity']/DisplayName$" $DisplayName
    $script:DiscoveryData.AddInstance($Component)
    Add-HcsRelationship $RelationshipType $Service $Component
    return $Component
}

function Get-HcsFabricServiceInstance {
    param([string]$VmmServer)

    $boundaryId = Get-HcsFabricBoundaryId -VmmServer $VmmServer
    $service = $script:DiscoveryData.CreateClassInstance("$MPElement[Name='HCSV2Library!HyperVPrivateCloud.Service']$")
    Add-HcsProperty $service "$MPElement[Name='HCSV2Library!HyperVPrivateCloud.Service']/BoundaryId$" $boundaryId
    Add-HcsProperty $service "$MPElement[Name='HCSV2Library!HyperVPrivateCloud.Service']/BoundaryType$" 'VirtualMachineManagerFabric'
    Add-HcsProperty $service "$MPElement[Name='System!System.Entity']/DisplayName$" ("VMM fabric - {0}" -f $VmmServer)
    $script:DiscoveryData.AddInstance($service)

    $components = @{}
    $components.Management = Complete-HcsFabricComponent -Service $service -Component ($script:DiscoveryData.CreateClassInstance("$MPElement[Name='HCSV2Library!HyperVPrivateCloud.ManagementComponent']$")) -RelationshipType "$MPElement[Name='HCSV2Library!HyperVPrivateCloud.ServiceContainsManagementComponent']$" -BoundaryId $boundaryId -DisplayName "Management - $VmmServer"
    $components.Compute = Complete-HcsFabricComponent -Service $service -Component ($script:DiscoveryData.CreateClassInstance("$MPElement[Name='HCSV2Library!HyperVPrivateCloud.ComputeComponent']$")) -RelationshipType "$MPElement[Name='HCSV2Library!HyperVPrivateCloud.ServiceContainsComputeComponent']$" -BoundaryId $boundaryId -DisplayName "Compute - $VmmServer"
    $components.VirtualMachines = Complete-HcsFabricComponent -Service $service -Component ($script:DiscoveryData.CreateClassInstance("$MPElement[Name='HCSV2Library!HyperVPrivateCloud.VirtualMachineComponent']$")) -RelationshipType "$MPElement[Name='HCSV2Library!HyperVPrivateCloud.ServiceContainsVirtualMachineComponent']$" -BoundaryId $boundaryId -DisplayName "Virtual Machines - $VmmServer"
    $components.Availability = Complete-HcsFabricComponent -Service $service -Component ($script:DiscoveryData.CreateClassInstance("$MPElement[Name='HCSV2Library!HyperVPrivateCloud.AvailabilityComponent']$")) -RelationshipType "$MPElement[Name='HCSV2Library!HyperVPrivateCloud.ServiceContainsAvailabilityComponent']$" -BoundaryId $boundaryId -DisplayName "Availability - $VmmServer"
    $components.Storage = Complete-HcsFabricComponent -Service $service -Component ($script:DiscoveryData.CreateClassInstance("$MPElement[Name='HCSV2Library!HyperVPrivateCloud.StorageComponent']$")) -RelationshipType "$MPElement[Name='HCSV2Library!HyperVPrivateCloud.ServiceContainsStorageComponent']$" -BoundaryId $boundaryId -DisplayName "Storage - $VmmServer"
    $components.Network = Complete-HcsFabricComponent -Service $service -Component ($script:DiscoveryData.CreateClassInstance("$MPElement[Name='HCSV2Library!HyperVPrivateCloud.NetworkComponent']$")) -RelationshipType "$MPElement[Name='HCSV2Library!HyperVPrivateCloud.ServiceContainsNetworkComponent']$" -BoundaryId $boundaryId -DisplayName "Networking - $VmmServer"
    $components.Monitoring = Complete-HcsFabricComponent -Service $service -Component ($script:DiscoveryData.CreateClassInstance("$MPElement[Name='HCSV2Library!HyperVPrivateCloud.MonitoringComponent']$")) -RelationshipType "$MPElement[Name='HCSV2Library!HyperVPrivateCloud.ServiceContainsMonitoringComponent']$" -BoundaryId $boundaryId -DisplayName "Monitoring - $VmmServer"
    return $components
}

function Get-HcsSubnetVlanSummary {
    param($NetworkSite)

    $items = [System.Collections.Generic.List[string]]::new()
    $subnetVlans = @(Get-HcsObjectProperty -InputObject $NetworkSite -Name 'SubnetVLans' -DefaultValue @())
    foreach ($entry in $subnetVlans) {
        $subnet = [string](Get-HcsObjectProperty -InputObject $entry -Name 'Subnet')
        $vlan = [string](Get-HcsObjectProperty -InputObject $entry -Name 'VLanID')
        if (-not [string]::IsNullOrWhiteSpace($subnet) -or -not [string]::IsNullOrWhiteSpace($vlan)) {
            $items.Add(("{0} VLAN {1}" -f $subnet, $vlan).Trim())
        }
    }
    return ($items -join '; ')
}

$api = New-Object -ComObject 'MOM.ScriptAPI'
$script:DiscoveryData = $api.CreateDiscoveryData(0, $SourceId, $ManagedEntityId)

try {
    $components = Get-HcsFabricServiceInstance -VmmServer $ComputerName

    $vmmServerInstance = $script:DiscoveryData.CreateClassInstance("$MPElement[Name='VMMDiscovery!Microsoft.SystemCenter.VirtualMachineManager.Discovery.VMMManagementServer']$")
    Add-HcsProperty $vmmServerInstance "$MPElement[Name='Windows!Microsoft.Windows.Computer']/PrincipalName$" $ComputerName
    Add-HcsRelationship "$MPElement[Name='HyperVPrivateCloud.Capability.VMM.ManagementContainsVMMManagementServer']$" $components.Management $vmmServerInstance

    $module = Get-Module -ListAvailable -Name 'VirtualMachineManager' | Select-Object -First 1
    if ($null -eq $module) {
        $api.LogScriptEvent('HyperVPrivateCloud.VMM.FabricDiscovery.ps1', 8510, 2, 'The VirtualMachineManager PowerShell module is unavailable. Logical-network and network-site discovery was skipped.')
        $api.Return($script:DiscoveryData)
        return
    }

    Import-Module -Name $module.Path -ErrorAction Stop
    foreach ($commandName in @('Get-SCVMMServer', 'Get-SCLogicalNetwork', 'Get-SCLogicalNetworkDefinition', 'Get-SCVMNetwork')) {
        if ($null -eq (Get-Command -Name $commandName -ErrorAction SilentlyContinue)) {
            throw "Required VMM command '$commandName' is unavailable."
        }
    }

    $vmmConnection = Get-SCVMMServer -ComputerName $ComputerName
    $logicalNetworks = @(Get-SCLogicalNetwork -VMMServer $vmmConnection -All)
    foreach ($logicalNetwork in $logicalNetworks) {
        $logicalNetworkId = [string](Get-HcsObjectProperty -InputObject $logicalNetwork -Name 'ID')
        if ([string]::IsNullOrWhiteSpace($logicalNetworkId)) { continue }

        $logicalNetworkInstance = $script:DiscoveryData.CreateClassInstance("$MPElement[Name='HyperVPrivateCloud.Capability.VMM.LogicalNetwork']$")
        Add-HcsProperty $logicalNetworkInstance "$MPElement[Name='HyperVPrivateCloud.Capability.VMM.LogicalNetwork']/VMMServer$" $ComputerName
        Add-HcsProperty $logicalNetworkInstance "$MPElement[Name='HyperVPrivateCloud.Capability.VMM.LogicalNetwork']/LogicalNetworkId$" $logicalNetworkId
        Add-HcsProperty $logicalNetworkInstance "$MPElement[Name='HyperVPrivateCloud.Capability.VMM.LogicalNetwork']/Name$" (Get-HcsObjectProperty -InputObject $logicalNetwork -Name 'Name')
        Add-HcsProperty $logicalNetworkInstance "$MPElement[Name='HyperVPrivateCloud.Capability.VMM.LogicalNetwork']/Description$" (Get-HcsObjectProperty -InputObject $logicalNetwork -Name 'Description')
        Add-HcsProperty $logicalNetworkInstance "$MPElement[Name='HyperVPrivateCloud.Capability.VMM.LogicalNetwork']/NetworkVirtualizationEnabled$" (Get-HcsObjectProperty -InputObject $logicalNetwork -Name 'NetworkVirtualizationEnabled')
        Add-HcsProperty $logicalNetworkInstance "$MPElement[Name='System!System.Entity']/DisplayName$" (Get-HcsObjectProperty -InputObject $logicalNetwork -Name 'Name' -DefaultValue $logicalNetworkId)
        $script:DiscoveryData.AddInstance($logicalNetworkInstance)
        Add-HcsRelationship "$MPElement[Name='HyperVPrivateCloud.Capability.VMM.NetworkContainsLogicalNetwork']$" $components.Network $logicalNetworkInstance

        $networkSites = @(Get-SCLogicalNetworkDefinition -VMMServer $vmmConnection -LogicalNetwork $logicalNetwork -ReturnAllTypes)
        foreach ($networkSite in $networkSites) {
            $networkSiteId = [string](Get-HcsObjectProperty -InputObject $networkSite -Name 'ID')
            if ([string]::IsNullOrWhiteSpace($networkSiteId)) { continue }
            $hostGroups = @(Get-HcsObjectProperty -InputObject $networkSite -Name 'VMHostGroups' -DefaultValue @()) | ForEach-Object { [string](Get-HcsObjectProperty -InputObject $_ -Name 'Path' -DefaultValue (Get-HcsObjectProperty -InputObject $_ -Name 'Name')) }

            $networkSiteInstance = $script:DiscoveryData.CreateClassInstance("$MPElement[Name='HyperVPrivateCloud.Capability.VMM.NetworkSite']$")
            Add-HcsProperty $networkSiteInstance "$MPElement[Name='HyperVPrivateCloud.Capability.VMM.NetworkSite']/VMMServer$" $ComputerName
            Add-HcsProperty $networkSiteInstance "$MPElement[Name='HyperVPrivateCloud.Capability.VMM.NetworkSite']/NetworkSiteId$" $networkSiteId
            Add-HcsProperty $networkSiteInstance "$MPElement[Name='HyperVPrivateCloud.Capability.VMM.NetworkSite']/LogicalNetworkId$" $logicalNetworkId
            Add-HcsProperty $networkSiteInstance "$MPElement[Name='HyperVPrivateCloud.Capability.VMM.NetworkSite']/Name$" (Get-HcsObjectProperty -InputObject $networkSite -Name 'Name')
            Add-HcsProperty $networkSiteInstance "$MPElement[Name='HyperVPrivateCloud.Capability.VMM.NetworkSite']/HostGroupSummary$" ($hostGroups -join '; ')
            Add-HcsProperty $networkSiteInstance "$MPElement[Name='HyperVPrivateCloud.Capability.VMM.NetworkSite']/SubnetVlanSummary$" (Get-HcsSubnetVlanSummary -NetworkSite $networkSite)
            Add-HcsProperty $networkSiteInstance "$MPElement[Name='System!System.Entity']/DisplayName$" (Get-HcsObjectProperty -InputObject $networkSite -Name 'Name' -DefaultValue $networkSiteId)
            $script:DiscoveryData.AddInstance($networkSiteInstance)
            Add-HcsRelationship "$MPElement[Name='HyperVPrivateCloud.Capability.VMM.LogicalNetworkContainsNetworkSite']$" $logicalNetworkInstance $networkSiteInstance
        }

        $vmNetworks = @(Get-SCVMNetwork -VMMServer $vmmConnection -LogicalNetwork $logicalNetwork)
        foreach ($vmNetwork in $vmNetworks) {
            $vmNetworkId = [string](Get-HcsObjectProperty -InputObject $vmNetwork -Name 'ID')
            if ([string]::IsNullOrWhiteSpace($vmNetworkId)) { continue }
            $vmNetworkInstance = $script:DiscoveryData.CreateClassInstance("$MPElement[Name='VMMDiscovery!Microsoft.SystemCenter.VirtualMachineManager.Discovery.VMNetwork']$")
            Add-HcsProperty $vmNetworkInstance "$MPElement[Name='VMMBase!Microsoft.SystemCenter.VirtualMachineManager.VMNetwork']/VMNetworkId$" $vmNetworkId
            Add-HcsProperty $vmNetworkInstance "$MPElement[Name='VMMBase!Microsoft.SystemCenter.VirtualMachineManager.VMNetwork']/VMMServer$" $ComputerName
            Add-HcsRelationship "$MPElement[Name='HyperVPrivateCloud.Capability.VMM.LogicalNetworkReferencesVMNetwork']$" $logicalNetworkInstance $vmNetworkInstance
        }
    }

    $api.Return($script:DiscoveryData)
}
catch {
    $api.LogScriptEvent('HyperVPrivateCloud.VMM.FabricDiscovery.ps1', 8510, 1, $_.Exception.Message)
    $api.Return($script:DiscoveryData)
}
