<?xml version="1.0" encoding="utf-8"?>
<ManagementPack ContentReadable="true" SchemaVersion="2.0" OriginalSchemaVersion="2.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
  <Manifest>
    <Identity><ID>HyperVPrivateCloud.Discovery</ID><Version>{{VERSION}}</Version></Identity>
    <Name>Hyper-V Private Cloud Monitoring Discovery</Name>
    <References>
      <Reference Alias="System"><ID>System.Library</ID><Version>7.5.8501.0</Version><PublicKeyToken>31bf3856ad364e35</PublicKeyToken></Reference>
      <Reference Alias="Windows"><ID>Microsoft.Windows.Library</ID><Version>7.5.8501.0</Version><PublicKeyToken>31bf3856ad364e35</PublicKeyToken></Reference>
      <Reference Alias="SC"><ID>Microsoft.SystemCenter.Library</ID><Version>7.0.8433.0</Version><PublicKeyToken>31bf3856ad364e35</PublicKeyToken></Reference>
      <Reference Alias="InstanceGroup"><ID>Microsoft.SystemCenter.InstanceGroup.Library</ID><Version>7.5.8501.0</Version><PublicKeyToken>31bf3856ad364e35</PublicKeyToken></Reference>
      <Reference Alias="HCSV2Library"><ID>HyperVPrivateCloud.Library</ID><Version>{{VERSION}}</Version><PublicKeyToken>{{PUBLIC_KEY_TOKEN}}</PublicKeyToken></Reference>
    </References>
  </Manifest>
  <Monitoring>
    <Discoveries>
      <Discovery ID="HyperVPrivateCloud.HostRole.Seed.Discovery" Enabled="true" Target="Windows!Microsoft.Windows.Server.OperatingSystem" ConfirmDelivery="false" Remotable="true" Priority="Normal">
        <Category>Discovery</Category>
        <DiscoveryTypes><DiscoveryClass TypeID="HCSV2Library!HyperVPrivateCloud.HostRole" /></DiscoveryTypes>
        <DataSource ID="RegistrySeed" TypeID="Windows!Microsoft.Windows.FilteredRegistryDiscoveryProvider">
          <ComputerName>$Target/Host/Property[Type="Windows!Microsoft.Windows.Computer"]/PrincipalName$</ComputerName>
          <RegistryAttributeDefinitions>
            <RegistryAttributeDefinition><AttributeName>VMMSServiceExists</AttributeName><Path>SYSTEM\CurrentControlSet\Services\vmms</Path><PathType>0</PathType><AttributeType>0</AttributeType></RegistryAttributeDefinition>
          </RegistryAttributeDefinitions>
          <Frequency>14400</Frequency>
          <ClassId>$MPElement[Name="HCSV2Library!HyperVPrivateCloud.HostRole"]$</ClassId>
          <InstanceSettings><Settings>
            <Setting><Name>$MPElement[Name="Windows!Microsoft.Windows.Computer"]/PrincipalName$</Name><Value>$Target/Host/Property[Type="Windows!Microsoft.Windows.Computer"]/PrincipalName$</Value></Setting>
            <Setting><Name>$MPElement[Name="HCSV2Library!HyperVPrivateCloud.HostRole"]/HostId$</Name><Value>$Target/Host/Property[Type="Windows!Microsoft.Windows.Computer"]/PrincipalName$</Value></Setting>
            <Setting><Name>$MPElement[Name="System!System.Entity"]/DisplayName$</Name><Value>Hyper-V on $Target/Host/Property[Type="Windows!Microsoft.Windows.Computer"]/PrincipalName$</Value></Setting>
          </Settings></InstanceSettings>
          <Expression><SimpleExpression><ValueExpression><XPathQuery Type="Boolean">Values/VMMSServiceExists</XPathQuery></ValueExpression><Operator>Equal</Operator><ValueExpression><Value Type="Boolean">true</Value></ValueExpression></SimpleExpression></Expression>
        </DataSource>
      </Discovery>
      <Discovery ID="HyperVPrivateCloud.Topology.Discovery" Enabled="true" Target="HCSV2Library!HyperVPrivateCloud.HostRole" ConfirmDelivery="false" Remotable="true" Priority="Normal">
        <Category>Discovery</Category>
        <DiscoveryTypes>
          <DiscoveryClass TypeID="HCSV2Library!HyperVPrivateCloud.HostRole" />
          <DiscoveryClass TypeID="HCSV2Library!HyperVPrivateCloud.Boundary" />
          <DiscoveryClass TypeID="HCSV2Library!HyperVPrivateCloud.VirtualMachine" />
          <DiscoveryClass TypeID="HCSV2Library!HyperVPrivateCloud.VirtualMachineRuntime" />
          <DiscoveryClass TypeID="HCSV2Library!HyperVPrivateCloud.VirtualHardDisk" />
          <DiscoveryClass TypeID="HCSV2Library!HyperVPrivateCloud.VirtualNetworkAdapter" />
          <DiscoveryClass TypeID="HCSV2Library!HyperVPrivateCloud.VirtualSwitch" />
          <DiscoveryClass TypeID="HCSV2Library!HyperVPrivateCloud.ReplicationRelationship" />
          <DiscoveryClass TypeID="HCSV2Library!HyperVPrivateCloud.MonitoringPipeline" />
          <DiscoveryClass TypeID="HCSV2Library!HyperVPrivateCloud.Service" />
          <DiscoveryClass TypeID="HCSV2Library!HyperVPrivateCloud.ManagementComponent" />
          <DiscoveryClass TypeID="HCSV2Library!HyperVPrivateCloud.ComputeComponent" />
          <DiscoveryClass TypeID="HCSV2Library!HyperVPrivateCloud.VirtualMachineComponent" />
          <DiscoveryClass TypeID="HCSV2Library!HyperVPrivateCloud.AvailabilityComponent" />
          <DiscoveryClass TypeID="HCSV2Library!HyperVPrivateCloud.StorageComponent" />
          <DiscoveryClass TypeID="HCSV2Library!HyperVPrivateCloud.NetworkComponent" />
          <DiscoveryClass TypeID="HCSV2Library!HyperVPrivateCloud.MonitoringComponent" />
          <DiscoveryRelationship TypeID="HCSV2Library!HyperVPrivateCloud.BoundaryContainsHostRole" />
          <DiscoveryRelationship TypeID="HCSV2Library!HyperVPrivateCloud.BoundaryContainsVirtualMachine" />
          <DiscoveryRelationship TypeID="HCSV2Library!HyperVPrivateCloud.BoundaryContainsVirtualSwitch" />
          <DiscoveryRelationship TypeID="HCSV2Library!HyperVPrivateCloud.HostRoleRunsVirtualMachine" />
          <DiscoveryRelationship TypeID="HCSV2Library!HyperVPrivateCloud.VirtualMachineHasRuntime" />
          <DiscoveryRelationship TypeID="HCSV2Library!HyperVPrivateCloud.VirtualMachineContainsVirtualHardDisk" />
          <DiscoveryRelationship TypeID="HCSV2Library!HyperVPrivateCloud.VirtualMachineContainsVirtualNetworkAdapter" />
          <DiscoveryRelationship TypeID="HCSV2Library!HyperVPrivateCloud.VirtualNetworkAdapterConnectsVirtualSwitch" />
          <DiscoveryRelationship TypeID="HCSV2Library!HyperVPrivateCloud.VirtualMachineContainsReplicationRelationship" />
          <DiscoveryRelationship TypeID="HCSV2Library!HyperVPrivateCloud.ServiceContainsManagementComponent" />
          <DiscoveryRelationship TypeID="HCSV2Library!HyperVPrivateCloud.ServiceContainsComputeComponent" />
          <DiscoveryRelationship TypeID="HCSV2Library!HyperVPrivateCloud.ServiceContainsVirtualMachineComponent" />
          <DiscoveryRelationship TypeID="HCSV2Library!HyperVPrivateCloud.ServiceContainsAvailabilityComponent" />
          <DiscoveryRelationship TypeID="HCSV2Library!HyperVPrivateCloud.ServiceContainsStorageComponent" />
          <DiscoveryRelationship TypeID="HCSV2Library!HyperVPrivateCloud.ServiceContainsNetworkComponent" />
          <DiscoveryRelationship TypeID="HCSV2Library!HyperVPrivateCloud.ServiceContainsMonitoringComponent" />
          <DiscoveryRelationship TypeID="HCSV2Library!HyperVPrivateCloud.ManagementComponentContainsHostRole" />
          <DiscoveryRelationship TypeID="HCSV2Library!HyperVPrivateCloud.ComputeComponentContainsHostRole" />
          <DiscoveryRelationship TypeID="HCSV2Library!HyperVPrivateCloud.VirtualMachineComponentContainsVirtualMachine" />
          <DiscoveryRelationship TypeID="HCSV2Library!HyperVPrivateCloud.VirtualMachineComponentContainsRuntime" />
          <DiscoveryRelationship TypeID="HCSV2Library!HyperVPrivateCloud.AvailabilityComponentContainsRuntime" />
          <DiscoveryRelationship TypeID="HCSV2Library!HyperVPrivateCloud.StorageComponentContainsRuntime" />
          <DiscoveryRelationship TypeID="HCSV2Library!HyperVPrivateCloud.NetworkComponentContainsRuntime" />
          <DiscoveryRelationship TypeID="HCSV2Library!HyperVPrivateCloud.AvailabilityComponentContainsReplicationRelationship" />
          <DiscoveryRelationship TypeID="HCSV2Library!HyperVPrivateCloud.StorageComponentContainsVirtualHardDisk" />
          <DiscoveryRelationship TypeID="HCSV2Library!HyperVPrivateCloud.NetworkComponentContainsVirtualSwitch" />
          <DiscoveryRelationship TypeID="HCSV2Library!HyperVPrivateCloud.NetworkComponentContainsVirtualNetworkAdapter" />
          <DiscoveryRelationship TypeID="HCSV2Library!HyperVPrivateCloud.MonitoringComponentContainsPipeline" />
          <DiscoveryRelationship TypeID="HCSV2Library!HyperVPrivateCloud.MonitoringComponentContainsHostRole" />
        </DiscoveryTypes>
        <DataSource ID="PowerShellDiscovery" TypeID="HCSV2Library!HyperVPrivateCloud.Pwsh.DiscoveryProvider">
          <IntervalSeconds>1800</IntervalSeconds><ScriptName>HyperVPrivateCloud.Topology.Discovery.ps1</ScriptName>
          <ScriptBody><![CDATA[{{TOPOLOGY_DISCOVERY_SCRIPT}}]]></ScriptBody>
          <Arguments>-SourceId "$MPElement$" -ManagedEntityId "$Target/Id$" -ComputerName "$Target/Host/Property[Type=&quot;Windows!Microsoft.Windows.Computer&quot;]/PrincipalName$"</Arguments>
          <TimeoutSeconds>300</TimeoutSeconds>
        </DataSource>
      </Discovery>
      <Discovery ID="HyperVPrivateCloud.Product.Group.Discovery" Enabled="true" Target="HCSV2Library!HyperVPrivateCloud.Product.Group" ConfirmDelivery="false" Remotable="true" Priority="Normal"><Category>Discovery</Category><DiscoveryTypes><DiscoveryRelationship TypeID="InstanceGroup!Microsoft.SystemCenter.InstanceGroupContainsEntities" /></DiscoveryTypes><DataSource ID="GroupPopulator" TypeID="SC!Microsoft.SystemCenter.GroupPopulator"><RuleId>$MPElement$</RuleId><GroupInstanceId>$MPElement[Name="HCSV2Library!HyperVPrivateCloud.Product.Group"]$</GroupInstanceId><MembershipRules><MembershipRule><MonitoringClass>$MPElement[Name="HCSV2Library!HyperVPrivateCloud.Service"]$</MonitoringClass><RelationshipClass>$MPElement[Name="InstanceGroup!Microsoft.SystemCenter.InstanceGroupContainsEntities"]$</RelationshipClass></MembershipRule><MembershipRule><MonitoringClass>$MPElement[Name="System!System.Entity"]$</MonitoringClass><RelationshipClass>$MPElement[Name="InstanceGroup!Microsoft.SystemCenter.InstanceGroupContainsEntities"]$</RelationshipClass><Expression><Contained><MonitoringClass>$MPElement[Name="HCSV2Library!HyperVPrivateCloud.Service"]$</MonitoringClass></Contained></Expression></MembershipRule></MembershipRules></DataSource></Discovery>
    </Discoveries>
  </Monitoring>
  <LanguagePacks>
    <LanguagePack ID="ENU" IsDefault="true">
      <DisplayStrings>
        <DisplayString ElementID="HyperVPrivateCloud.Product.Group.Discovery"><Name>Populate Hyper-V Private Cloud Objects group</Name><Description>Adds every Distributed Application instance and every object it contains to the Hyper-V Private Cloud Objects group.</Description></DisplayString>
        <DisplayString ElementID="HyperVPrivateCloud.Discovery"><Name>Hyper-V Private Cloud Monitoring Discovery</Name><Description>Discovers core Hyper-V hosts, stable boundaries, virtual machines, virtual disks and adapters, switches, Replica relationships, monitoring pipelines, and Distributed Application membership.</Description></DisplayString>
        <DisplayString ElementID="HyperVPrivateCloud.HostRole.Seed.Discovery"><Name>Discover Hyper-V host role</Name><Description>Discovers the Hyper-V host role when the Virtual Machine Management service is installed.</Description></DisplayString>
        <DisplayString ElementID="HyperVPrivateCloud.Topology.Discovery"><Name>Discover Hyper-V private-cloud core topology</Name><Description>Discovers standalone-safe, boundary-scoped Hyper-V topology and dynamically populates the seven-branch private-cloud Distributed Application. Optional product topology is supplied by capability MPs.</Description></DisplayString>
      </DisplayStrings>
    </LanguagePack>
  </LanguagePacks>
</ManagementPack>
