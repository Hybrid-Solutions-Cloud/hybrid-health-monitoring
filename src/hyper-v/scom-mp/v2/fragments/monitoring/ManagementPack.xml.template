  <LanguagePacks><LanguagePack ID="ENU" IsDefault="true"><DisplayStrings>
    <DisplayString ElementID="HyperVPrivateCloud.Monitoring"><Name>Hyper-V Private Cloud Monitoring</Name><Description>Health, alert, performance collection, diagnostic task, and Distributed Application rollup workflows for Hyper-V.</Description></DisplayString>
    {{MONITOR_DISPLAY_STRINGS}}
    <DisplayString ElementID="HyperVPrivateCloud.Host.LogicalProcessorUtilization.Monitor"><Name>Hyper-V host logical processor utilization</Name><Description>Tracks total hypervisor logical-processor run time across the whole host. Warning at 80 percent and Critical at 92 percent of total run time; both thresholds are overridable.</Description></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.Host.LogicalProcessorUtilization.Monitor" SubElementID="Good"><Name>Within threshold</Name></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.Host.LogicalProcessorUtilization.Monitor" SubElementID="Warning"><Name>Warning threshold exceeded</Name></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.Host.LogicalProcessorUtilization.Monitor" SubElementID="Critical"><Name>Critical threshold exceeded</Name></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.Host.LogicalProcessorUtilization.Monitor.Message"><Name>Hyper-V host logical processor utilization</Name><Description>Tracks total hypervisor logical-processor run time across the whole host. Warning at 80 percent and Critical at 92 percent of total run time; both thresholds are overridable. Measured value: {0}. Probe: {1}</Description></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.Host.RootVirtualProcessorUtilization.Monitor"><Name>Hyper-V root partition virtual processor utilization</Name><Description>Tracks run time in the management partition, which serves guest storage and network I/O. Warning at 70 percent and Critical at 85 percent of total run time; both thresholds are overridable.</Description></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.Host.RootVirtualProcessorUtilization.Monitor" SubElementID="Good"><Name>Within threshold</Name></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.Host.RootVirtualProcessorUtilization.Monitor" SubElementID="Warning"><Name>Warning threshold exceeded</Name></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.Host.RootVirtualProcessorUtilization.Monitor" SubElementID="Critical"><Name>Critical threshold exceeded</Name></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.Host.RootVirtualProcessorUtilization.Monitor.Message"><Name>Hyper-V root partition virtual processor utilization</Name><Description>Tracks run time in the management partition, which serves guest storage and network I/O. Warning at 70 percent and Critical at 85 percent of total run time; both thresholds are overridable. Measured value: {0}. Probe: {1}</Description></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.Host.GuestVirtualProcessorUtilization.Monitor"><Name>Hyper-V aggregate guest virtual processor utilization</Name><Description>Tracks aggregate run time across every guest virtual processor on the host. Warning at 85 percent and Critical at 95 percent of total run time; both thresholds are overridable.</Description></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.Host.GuestVirtualProcessorUtilization.Monitor" SubElementID="Good"><Name>Within threshold</Name></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.Host.GuestVirtualProcessorUtilization.Monitor" SubElementID="Warning"><Name>Warning threshold exceeded</Name></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.Host.GuestVirtualProcessorUtilization.Monitor" SubElementID="Critical"><Name>Critical threshold exceeded</Name></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.Host.GuestVirtualProcessorUtilization.Monitor.Message"><Name>Hyper-V aggregate guest virtual processor utilization</Name><Description>Tracks aggregate run time across every guest virtual processor on the host. Warning at 85 percent and Critical at 95 percent of total run time; both thresholds are overridable. Measured value: {0}. Probe: {1}</Description></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.Host.AvailableMemory.Monitor"><Name>Hyper-V host available memory (absolute)</Name><Description>Tracks absolute physical memory available to the host. Warning at or below 8192 MB and Critical at or below 4096 MB; both thresholds are overridable and should be raised on hosts with large VMs.</Description></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.Host.AvailableMemory.Monitor" SubElementID="Good"><Name>Within threshold</Name></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.Host.AvailableMemory.Monitor" SubElementID="Warning"><Name>Warning threshold exceeded</Name></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.Host.AvailableMemory.Monitor" SubElementID="Critical"><Name>Critical threshold exceeded</Name></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.Host.AvailableMemory.Monitor.Message"><Name>Hyper-V host available memory (absolute)</Name><Description>Tracks absolute physical memory available to the host. Warning at or below 8192 MB and Critical at or below 4096 MB; both thresholds are overridable and should be raised on hosts with large VMs. Measured value: {0}. Probe: {1}</Description></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.Host.AvailableMemoryPercent.Monitor"><Name>Hyper-V host available memory (proportional)</Name><Description>Tracks physical memory available to the host as a percentage of installed memory, so the same policy scales across differently sized hosts. Warning at or below 15 percent and Critical at or below 8 percent; both thresholds are overridable.</Description></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.Host.AvailableMemoryPercent.Monitor" SubElementID="Good"><Name>Within threshold</Name></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.Host.AvailableMemoryPercent.Monitor" SubElementID="Warning"><Name>Warning threshold exceeded</Name></DisplayString>
