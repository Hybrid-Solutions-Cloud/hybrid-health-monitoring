    <DisplayString ElementID="HyperVPrivateCloud.VmRuntime.VirtualProcessorPeakSaturation.Monitor.Message"><Name>VM virtual processor peak saturation</Name><Description>Tracks the busiest single virtual processor of this VM, which exposes single-threaded bottlenecks that the average hides. Warning at 90 percent and Critical at 98 percent; both thresholds are overridable. Measured value: {0}. Probe: {1}</Description></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.VmRuntime.MemoryPressureRatio.Monitor"><Name>VM memory pressure</Name><Description>Tracks Hyper-V memory pressure for this VM, the ratio of memory demanded by the guest to memory currently assigned by the host. Warning at 90 percent and Critical at 100 percent, where demand has met or exceeded assigned memory; both thresholds are overridable.</Description></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.VmRuntime.MemoryPressureRatio.Monitor" SubElementID="Good"><Name>Within threshold</Name></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.VmRuntime.MemoryPressureRatio.Monitor" SubElementID="Warning"><Name>Warning threshold exceeded</Name></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.VmRuntime.MemoryPressureRatio.Monitor" SubElementID="Critical"><Name>Critical threshold exceeded</Name></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.VmRuntime.MemoryPressureRatio.Monitor.Message"><Name>VM memory pressure</Name><Description>Tracks Hyper-V memory pressure for this VM, the ratio of memory demanded by the guest to memory currently assigned by the host. Warning at 90 percent and Critical at 100 percent, where demand has met or exceeded assigned memory; both thresholds are overridable. Measured value: {0}. Probe: {1}</Description></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.VmRuntime.MemoryDemandHeadroom.Monitor"><Name>VM memory demand headroom</Name><Description>Tracks guest memory demand as a percentage of the configured Dynamic Memory maximum, giving early warning before the VM hits its ceiling. Warning at 85 percent and Critical at 95 percent of maximum memory; both thresholds are overridable.</Description></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.VmRuntime.MemoryDemandHeadroom.Monitor" SubElementID="Good"><Name>Within threshold</Name></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.VmRuntime.MemoryDemandHeadroom.Monitor" SubElementID="Warning"><Name>Warning threshold exceeded</Name></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.VmRuntime.MemoryDemandHeadroom.Monitor" SubElementID="Critical"><Name>Critical threshold exceeded</Name></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.VmRuntime.MemoryDemandHeadroom.Monitor.Message"><Name>VM memory demand headroom</Name><Description>Tracks guest memory demand as a percentage of the configured Dynamic Memory maximum, giving early warning before the VM hits its ceiling. Warning at 85 percent and Critical at 95 percent of maximum memory; both thresholds are overridable. Measured value: {0}. Probe: {1}</Description></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.VmRuntime.VirtualStorageLatency.Monitor"><Name>VM virtual storage device latency</Name><Description>Tracks the worst virtual storage device latency in milliseconds across the virtual disks attached to this VM. Warning at 30 ms and Critical at 60 ms; both thresholds are overridable and should be lowered on all-flash storage.</Description></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.VmRuntime.VirtualStorageLatency.Monitor" SubElementID="Good"><Name>Within threshold</Name></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.VmRuntime.VirtualStorageLatency.Monitor" SubElementID="Warning"><Name>Warning threshold exceeded</Name></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.VmRuntime.VirtualStorageLatency.Monitor" SubElementID="Critical"><Name>Critical threshold exceeded</Name></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.VmRuntime.VirtualStorageLatency.Monitor.Message"><Name>VM virtual storage device latency</Name><Description>Tracks the worst virtual storage device latency in milliseconds across the virtual disks attached to this VM. Warning at 30 ms and Critical at 60 ms; both thresholds are overridable and should be lowered on all-flash storage. Measured value: {0}. Probe: {1}</Description></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.VmRuntime.VirtualStorageQueueLength.Monitor"><Name>VM virtual storage device queue length</Name><Description>Tracks the worst virtual storage device queue length across the virtual disks attached to this VM. Warning at 8 outstanding requests and Critical at 20; both thresholds are overridable.</Description></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.VmRuntime.VirtualStorageQueueLength.Monitor" SubElementID="Good"><Name>Within threshold</Name></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.VmRuntime.VirtualStorageQueueLength.Monitor" SubElementID="Warning"><Name>Warning threshold exceeded</Name></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.VmRuntime.VirtualStorageQueueLength.Monitor" SubElementID="Critical"><Name>Critical threshold exceeded</Name></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.VmRuntime.VirtualStorageQueueLength.Monitor.Message"><Name>VM virtual storage device queue length</Name><Description>Tracks the worst virtual storage device queue length across the virtual disks attached to this VM. Warning at 8 outstanding requests and Critical at 20; both thresholds are overridable. Measured value: {0}. Probe: {1}</Description></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.HostPerformance.DataSource"><Name>Hyper-V host performance acquisition</Name><Description>Runs the shared Hyper-V host probe in performance mode and returns raw host resource-consumption measurements. Carries acquisition configuration only so that every consuming monitor cooks down to a single probe run.</Description></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.VmPerformance.DataSource"><Name>Hyper-V per-VM performance acquisition</Name><Description>Runs the shared per-VM probe in performance mode and returns raw processor, memory, virtual storage, and virtual network measurements for one VM. Guest workload internals are out of scope.</Description></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.HostPerformance.AboveThreshold.MonitorType"><Name>Host performance upper-threshold monitor type</Name><Description>Three-state monitor type that raises Warning and then Critical as a selected host measurement rises past two overridable thresholds.</Description></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.HostPerformance.BelowThreshold.MonitorType"><Name>Host performance lower-threshold monitor type</Name><Description>Three-state monitor type that raises Warning and then Critical as a selected host measurement falls below two overridable thresholds. Unavailable measurements are reported as healthy.</Description></DisplayString>
    <DisplayString ElementID="HyperVPrivateCloud.VmPerformance.AboveThreshold.MonitorType"><Name>Per-VM performance upper-threshold monitor type</Name><Description>Three-state monitor type that raises Warning and then Critical as a selected per-VM measurement rises past two overridable thresholds.</Description></DisplayString>
