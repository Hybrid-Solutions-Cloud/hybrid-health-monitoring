  <LanguagePacks><LanguagePack ID="ENU" IsDefault="true"><DisplayStrings>
        <DisplayString ElementID="HyperVPrivateCloud.Overrides.ClusteredPure.Standard.Monitoring"><Name>Hyper-V Private Cloud Monitoring - ClusteredPure Standard Monitoring Overrides</Name><Description>Unsealed, customer-owned Standard starter overrides for the ClusteredPure deployment profile. Review in a test management group, customize locally, and export after every change.</Description></DisplayString>
        <DisplayString ElementID="HyperVPrivateCloud.Overrides.ClusteredPure.Standard.Monitoring.Group.AllHosts"><Name>All Hyper-V private-cloud hosts</Name><Description>Dynamic override-target group generated in the same unsealed Management Pack as the overrides that reference it.</Description></DisplayString>
        <DisplayString ElementID="HyperVPrivateCloud.Overrides.ClusteredPure.Standard.Monitoring.Group.AllHosts.Discovery"><Name>Populate All Hyper-V private-cloud hosts</Name></DisplayString>
